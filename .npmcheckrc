{
  "depcheck": {
    "ignoreDirs": [
      "sandbox",
      "dist",
      "generated",
      ".generated",
      "build",
      "fixtures",
      "jspm_packages",
      ".agents",
      ".claude"
    ],
    "ignoreMatches": [
      "@fontsource-variable/geist-mono",
      "@fontsource-variable/inter",
      "release-it",
      "remark-cli",
      "remark-validate-links",
      "tailwindcss",
      "typescript-language-server"
    ]
  }
}
