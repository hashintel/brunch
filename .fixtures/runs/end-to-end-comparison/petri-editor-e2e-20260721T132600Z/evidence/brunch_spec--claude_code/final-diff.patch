diff --git a/src/petri.ts b/src/petri.ts
new file mode 100644
index 0000000..4d2b0f3
--- /dev/null
+++ b/src/petri.ts
@@ -0,0 +1,330 @@
+export interface Place {
+  id: string;
+  label: string;
+  x: number;
+  y: number;
+  initialTokens: number;
+  currentTokens: number;
+}
+
+export interface Transition {
+  id: string;
+  label: string;
+  x: number;
+  y: number;
+}
+
+export interface Arc {
+  id: string;
+  source: string;
+  target: string;
+  weight: number;
+}
+
+/** Export/import schema (REQ12). currentTokens is intentionally not persisted. */
+export interface PetriNetJSON {
+  places: Array<{
+    id: string;
+    label: string;
+    x: number;
+    y: number;
+    initialTokens: number;
+  }>;
+  transitions: Array<{ id: string; label: string; x: number; y: number }>;
+  arcs: Array<{ id: string; source: string; target: string; weight: number }>;
+}
+
+export type NodeKind = "place" | "transition";
+
+function isFiniteNumber(v: unknown): v is number {
+  return typeof v === "number" && Number.isFinite(v);
+}
+
+function isString(v: unknown): v is string {
+  return typeof v === "string";
+}
+
+export class PetriNetModel {
+  places: Place[] = [];
+  transitions: Transition[] = [];
+  arcs: Arc[] = [];
+
+  private counter = 0;
+  private placeLabelSeq = 0;
+  private transitionLabelSeq = 0;
+
+  private nextId(prefix: string): string {
+    const existing = this.allIds();
+    let id: string;
+    do {
+      id = `${prefix}${++this.counter}`;
+    } while (existing.has(id));
+    return id;
+  }
+
+  private allIds(): Set<string> {
+    const ids = new Set<string>();
+    for (const p of this.places) ids.add(p.id);
+    for (const t of this.transitions) ids.add(t.id);
+    for (const a of this.arcs) ids.add(a.id);
+    return ids;
+  }
+
+  getPlace(id: string): Place | undefined {
+    return this.places.find((p) => p.id === id);
+  }
+
+  getTransition(id: string): Transition | undefined {
+    return this.transitions.find((t) => t.id === id);
+  }
+
+  getArc(id: string): Arc | undefined {
+    return this.arcs.find((a) => a.id === id);
+  }
+
+  kindOf(id: string): NodeKind | undefined {
+    if (this.getPlace(id)) return "place";
+    if (this.getTransition(id)) return "transition";
+    return undefined;
+  }
+
+  labelOf(id: string): string {
+    return this.getPlace(id)?.label ?? this.getTransition(id)?.label ?? id;
+  }
+
+  addPlace(x: number, y: number, label?: string): Place {
+    const place: Place = {
+      id: this.nextId("p"),
+      label: label ?? `P${++this.placeLabelSeq}`,
+      x,
+      y,
+      initialTokens: 0,
+      currentTokens: 0,
+    };
+    this.places.push(place);
+    return place;
+  }
+
+  addTransition(x: number, y: number, label?: string): Transition {
+    const transition: Transition = {
+      id: this.nextId("t"),
+      label: label ?? `T${++this.transitionLabelSeq}`,
+      x,
+      y,
+    };
+    this.transitions.push(transition);
+    return transition;
+  }
+
+  /** INV1: an arc must connect exactly one place and one transition. */
+  canConnect(source: string, target: string): boolean {
+    const s = this.kindOf(source);
+    const t = this.kindOf(target);
+    if (!s || !t) return false;
+    return s !== t;
+  }
+
+  addArc(source: string, target: string, weight = 1): Arc | null {
+    if (!this.canConnect(source, target)) return null;
+    const arc: Arc = {
+      id: this.nextId("a"),
+      source,
+      target,
+      weight: Math.max(1, Math.floor(weight)),
+    };
+    this.arcs.push(arc);
+    return arc;
+  }
+
+  deleteNode(id: string): void {
+    this.places = this.places.filter((p) => p.id !== id);
+    this.transitions = this.transitions.filter((t) => t.id !== id);
+    this.arcs = this.arcs.filter((a) => a.source !== id && a.target !== id);
+  }
+
+  deleteArc(id: string): void {
+    this.arcs = this.arcs.filter((a) => a.id !== id);
+  }
+
+  moveNode(id: string, x: number, y: number): void {
+    const node = this.getPlace(id) ?? this.getTransition(id);
+    if (node) {
+      node.x = x;
+      node.y = y;
+    }
+  }
+
+  private inputArcs(transitionId: string): Arc[] {
+    return this.arcs.filter((a) => a.target === transitionId);
+  }
+
+  private outputArcs(transitionId: string): Arc[] {
+    return this.arcs.filter((a) => a.source === transitionId);
+  }
+
+  isEnabled(transitionId: string): boolean {
+    if (!this.getTransition(transitionId)) return false;
+    for (const arc of this.inputArcs(transitionId)) {
+      const place = this.getPlace(arc.source);
+      if (!place || place.currentTokens < arc.weight) return false;
+    }
+    return true;
+  }
+
+  fire(transitionId: string): boolean {
+    if (!this.isEnabled(transitionId)) return false;
+    // Standard P/T semantics: consume from inputs based on the current
+    // marking, then produce to outputs.
+    for (const arc of this.inputArcs(transitionId)) {
+      const place = this.getPlace(arc.source);
+      if (place) place.currentTokens -= arc.weight;
+    }
+    for (const arc of this.outputArcs(transitionId)) {
+      const place = this.getPlace(arc.target);
+      if (place) place.currentTokens += arc.weight;
+    }
+    return true;
+  }
+
+  resetMarking(): void {
+    for (const place of this.places) {
+      place.currentTokens = place.initialTokens;
+    }
+  }
+
+  clear(): void {
+    this.places = [];
+    this.transitions = [];
+    this.arcs = [];
+    this.placeLabelSeq = 0;
+    this.transitionLabelSeq = 0;
+  }
+
+  toJSON(): PetriNetJSON {
+    return {
+      places: this.places.map((p) => ({
+        id: p.id,
+        label: p.label,
+        x: p.x,
+        y: p.y,
+        initialTokens: p.initialTokens,
+      })),
+      transitions: this.transitions.map((t) => ({
+        id: t.id,
+        label: t.label,
+        x: t.x,
+        y: t.y,
+      })),
+      arcs: this.arcs.map((a) => ({
+        id: a.id,
+        source: a.source,
+        target: a.target,
+        weight: a.weight,
+      })),
+    };
+  }
+
+  static fromJSON(data: unknown): PetriNetModel {
+    if (typeof data !== "object" || data === null) {
+      throw new Error("Invalid net: expected a JSON object.");
+    }
+    const obj = data as Record<string, unknown>;
+    if (
+      !Array.isArray(obj.places) ||
+      !Array.isArray(obj.transitions) ||
+      !Array.isArray(obj.arcs)
+    ) {
+      throw new Error(
+        "Invalid net: 'places', 'transitions' and 'arcs' arrays are required.",
+      );
+    }
+
+    const model = new PetriNetModel();
+
+    for (const raw of obj.places) {
+      if (typeof raw !== "object" || raw === null) {
+        throw new Error("Invalid net: malformed place entry.");
+      }
+      const p = raw as Record<string, unknown>;
+      if (
+        !isString(p.id) ||
+        !isString(p.label) ||
+        !isFiniteNumber(p.x) ||
+        !isFiniteNumber(p.y) ||
+        !isFiniteNumber(p.initialTokens)
+      ) {
+        throw new Error("Invalid net: malformed place entry.");
+      }
+      const initialTokens = Math.max(0, Math.floor(p.initialTokens));
+      model.places.push({
+        id: p.id,
+        label: p.label,
+        x: p.x,
+        y: p.y,
+        initialTokens,
+        currentTokens: initialTokens,
+      });
+    }
+
+    for (const raw of obj.transitions) {
+      if (typeof raw !== "object" || raw === null) {
+        throw new Error("Invalid net: malformed transition entry.");
+      }
+      const t = raw as Record<string, unknown>;
+      if (
+        !isString(t.id) ||
+        !isString(t.label) ||
+        !isFiniteNumber(t.x) ||
+        !isFiniteNumber(t.y)
+      ) {
+        throw new Error("Invalid net: malformed transition entry.");
+      }
+      model.transitions.push({ id: t.id, label: t.label, x: t.x, y: t.y });
+    }
+
+    for (const raw of obj.arcs) {
+      if (typeof raw !== "object" || raw === null) {
+        throw new Error("Invalid net: malformed arc entry.");
+      }
+      const a = raw as Record<string, unknown>;
+      if (
+        !isString(a.id) ||
+        !isString(a.source) ||
+        !isString(a.target) ||
+        !isFiniteNumber(a.weight)
+      ) {
+        throw new Error("Invalid net: malformed arc entry.");
+      }
+      if (!model.canConnect(a.source, a.target)) {
+        throw new Error(
+          "Invalid net: arcs must connect a place and a transition.",
+        );
+      }
+      model.arcs.push({
+        id: a.id,
+        source: a.source,
+        target: a.target,
+        weight: Math.max(1, Math.floor(a.weight)),
+      });
+    }
+
+    model.seedCountersFromState();
+    return model;
+  }
+
+  /**
+   * After importing opaque ids, advance internal counters so freshly created
+   * elements never collide with imported ids and labels continue sensibly.
+   */
+  private seedCountersFromState(): void {
+    const ids = this.allIds();
+    let max = 0;
+    for (const id of ids) {
+      const m = /(\d+)$/.exec(id);
+      if (m) max = Math.max(max, Number(m[1]));
+    }
+    this.counter = max;
+    this.placeLabelSeq = this.places.length;
+    this.transitionLabelSeq = this.transitions.length;
+  }
+}
diff --git a/src/styles.css b/src/styles.css
new file mode 100644
index 0000000..81f8e3e
--- /dev/null
+++ b/src/styles.css
@@ -0,0 +1,279 @@
+:root {
+  --bg: #0f172a;
+  --panel: #1e293b;
+  --panel-2: #273449;
+  --line: #475569;
+  --text: #e2e8f0;
+  --muted: #94a3b8;
+  --accent: #38bdf8;
+  --accent-strong: #0ea5e9;
+  --enabled: #34d399;
+  --disabled: #64748b;
+  --danger: #f87171;
+  --place: #f8fafc;
+  --transition: #1e293b;
+}
+
+* {
+  box-sizing: border-box;
+}
+
+html,
+body {
+  margin: 0;
+  height: 100%;
+}
+
+body {
+  font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
+  background: var(--bg);
+  color: var(--text);
+}
+
+.app {
+  display: flex;
+  flex-direction: column;
+  gap: 12px;
+  padding: 16px;
+  min-height: 100vh;
+}
+
+.toolbar {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 8px;
+  align-items: center;
+}
+
+.control {
+  appearance: none;
+  border: 1px solid var(--line);
+  background: var(--panel-2);
+  color: var(--text);
+  padding: 8px 14px;
+  border-radius: 8px;
+  font-size: 14px;
+  cursor: pointer;
+  transition: background 0.15s ease, border-color 0.15s ease;
+}
+
+.control:hover {
+  background: #334155;
+}
+
+.control:focus-visible {
+  outline: 2px solid var(--accent);
+  outline-offset: 2px;
+}
+
+.control[aria-pressed="true"] {
+  background: var(--accent-strong);
+  border-color: var(--accent);
+  color: #04283a;
+  font-weight: 600;
+}
+
+.file-input {
+  position: absolute;
+  width: 1px;
+  height: 1px;
+  padding: 0;
+  margin: -1px;
+  overflow: hidden;
+  clip: rect(0 0 0 0);
+  white-space: nowrap;
+  border: 0;
+}
+
+.workspace {
+  display: flex;
+  gap: 12px;
+  align-items: stretch;
+  flex: 1;
+  min-height: 480px;
+}
+
+.canvas {
+  position: relative;
+  flex: 1;
+  min-height: 480px;
+  background: var(--panel);
+  background-image:
+    linear-gradient(rgba(148, 163, 184, 0.08) 1px, transparent 1px),
+    linear-gradient(90deg, rgba(148, 163, 184, 0.08) 1px, transparent 1px);
+  background-size: 30px 30px;
+  border-radius: 12px;
+  overflow: hidden;
+  touch-action: none;
+}
+
+.edges {
+  position: absolute;
+  inset: 0;
+  width: 100%;
+  height: 100%;
+  pointer-events: none;
+  color: var(--muted);
+}
+
+.arc-line {
+  stroke: var(--muted);
+  stroke-width: 2;
+}
+
+.temp-arc {
+  stroke: var(--accent);
+  stroke-width: 2;
+  stroke-dasharray: 6 4;
+}
+
+.node {
+  position: absolute;
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  justify-content: center;
+  gap: 2px;
+  border: 2px solid var(--line);
+  color: var(--transition);
+  cursor: grab;
+  padding: 0;
+  font-size: 13px;
+  touch-action: none;
+}
+
+.node:focus-visible {
+  outline: 2px solid var(--accent);
+  outline-offset: 2px;
+}
+
+.node.selected {
+  border-color: var(--accent);
+  box-shadow: 0 0 0 3px rgba(56, 189, 248, 0.4);
+}
+
+.node.place {
+  border-radius: 50%;
+  background: var(--place);
+  color: #0f172a;
+}
+
+.node.place .tokens {
+  font-weight: 700;
+  font-size: 16px;
+  line-height: 1;
+}
+
+.node.place .node-label {
+  font-size: 11px;
+  color: #334155;
+}
+
+.node.transition {
+  border-radius: 6px;
+  background: var(--transition);
+  color: var(--text);
+  border-color: var(--disabled);
+}
+
+.node.transition.enabled {
+  border-color: var(--enabled);
+  box-shadow: 0 0 0 2px rgba(52, 211, 153, 0.35);
+}
+
+.node.transition .node-label {
+  font-size: 12px;
+}
+
+.arc-handle {
+  position: absolute;
+  width: 24px;
+  height: 24px;
+  border-radius: 50%;
+  border: 1px solid var(--line);
+  background: var(--panel-2);
+  color: var(--text);
+  font-size: 12px;
+  line-height: 1;
+  cursor: pointer;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+}
+
+.arc-handle.selected {
+  border-color: var(--accent);
+  box-shadow: 0 0 0 3px rgba(56, 189, 248, 0.4);
+}
+
+.inspector {
+  width: 260px;
+  flex: none;
+  background: var(--panel);
+  border-radius: 12px;
+  padding: 16px;
+}
+
+.inspector-title {
+  margin: 0 0 12px;
+  font-size: 15px;
+  color: var(--muted);
+  text-transform: uppercase;
+  letter-spacing: 0.06em;
+}
+
+.hint {
+  color: var(--muted);
+  font-size: 13px;
+  line-height: 1.5;
+}
+
+.field {
+  display: flex;
+  flex-direction: column;
+  gap: 4px;
+  margin-bottom: 12px;
+}
+
+.field-name {
+  font-size: 12px;
+  color: var(--muted);
+}
+
+.field input {
+  background: var(--panel-2);
+  border: 1px solid var(--line);
+  border-radius: 6px;
+  color: var(--text);
+  padding: 7px 9px;
+  font-size: 14px;
+}
+
+.field input:focus-visible {
+  outline: 2px solid var(--accent);
+  outline-offset: 1px;
+}
+
+.feedback {
+  display: flex;
+  flex-direction: column;
+  gap: 6px;
+  min-height: 24px;
+}
+
+.status {
+  color: var(--accent);
+  font-size: 13px;
+  min-height: 18px;
+}
+
+.alert {
+  color: var(--danger);
+  font-size: 13px;
+  min-height: 18px;
+}
+
+.alert:empty,
+.status:empty {
+  min-height: 0;
+}
diff --git a/tests/dom.test.ts b/tests/dom.test.ts
new file mode 100644
index 0000000..5694e52
