+++ b/tests/dom.test.ts
@@ -0,0 +1,252 @@
+import { describe, it, expect, beforeEach, afterEach, vi } from "vitest";
+import { screen, fireEvent } from "@testing-library/dom";
+import { mountApp, type AppHandle } from "../src/app";
+
+let handle: AppHandle;
+
+beforeEach(() => {
+  document.body.innerHTML = "";
+  handle = mountApp(document.body);
+});
+
+afterEach(() => {
+  vi.restoreAllMocks();
+});
+
+const CONTROL_NAMES = [
+  "Add place",
+  "Add transition",
+  "Draw arc",
+  "Fire selected transition",
+  "Delete selection",
+  "New net",
+  "Reset marking",
+  "Export JSON",
+  "Import JSON",
+];
+
+describe("accessibility contract surface", () => {
+  it("exposes the application and canvas landmarks", () => {
+    expect(
+      screen.getByRole("application", { name: "Petri net editor" }),
+    ).toBeTruthy();
+    expect(
+      screen.getByRole("region", { name: "Petri net canvas" }),
+    ).toBeTruthy();
+  });
+
+  it("exposes every required control button by exact name", () => {
+    for (const name of CONTROL_NAMES) {
+      expect(screen.getByRole("button", { name })).toBeTruthy();
+    }
+  });
+
+  it("exposes status and alert live regions", () => {
+    expect(screen.getByRole("status")).toBeTruthy();
+    expect(screen.getByRole("alert")).toBeTruthy();
+  });
+
+  it("exposes a file input for importing JSON", () => {
+    const input = document.querySelector('input[type="file"]');
+    expect(input).toBeTruthy();
+  });
+});
+
+describe("createNode interaction", () => {
+  it("adds exactly one place named 'Place: <label>'", () => {
+    fireEvent.click(screen.getByRole("button", { name: "Add place" }));
+    const places = screen.getAllByRole("button", { name: /^Place: .+$/ });
+    expect(places).toHaveLength(1);
+    expect(handle.model.places).toHaveLength(1);
+  });
+
+  it("adds exactly one transition named 'Transition: <label> (enabled|disabled)'", () => {
+    fireEvent.click(screen.getByRole("button", { name: "Add transition" }));
+    const transitions = screen.getAllByRole("button", {
+      name: /^Transition: .+ \((enabled|disabled)\)$/,
+    });
+    expect(transitions).toHaveLength(1);
+    expect(handle.model.transitions).toHaveLength(1);
+  });
+
+  it("a transition with no inputs renders as enabled", () => {
+    fireEvent.click(screen.getByRole("button", { name: "Add transition" }));
+    expect(
+      screen.getByRole("button", { name: /^Transition: .+ \(enabled\)$/ }),
+    ).toBeTruthy();
+  });
+});
+
+describe("selection exposes applicable inspector fields", () => {
+  it("selecting a place exposes Label, Initial tokens and Current tokens", () => {
+    fireEvent.click(screen.getByRole("button", { name: "Add place" }));
+    fireEvent.click(screen.getByRole("button", { name: /^Place: / }));
+    expect(screen.getByRole("textbox", { name: "Label" })).toBeTruthy();
+    expect(screen.getByRole("spinbutton", { name: "Initial tokens" })).toBeTruthy();
+    expect(screen.getByRole("spinbutton", { name: "Current tokens" })).toBeTruthy();
+    expect(
+      screen.queryByRole("spinbutton", { name: "Arc weight" }),
+    ).toBeNull();
+  });
+
+  it("selecting a transition exposes only Label", () => {
+    fireEvent.click(screen.getByRole("button", { name: "Add transition" }));
+    fireEvent.click(screen.getByRole("button", { name: /^Transition: / }));
+    expect(screen.getByRole("textbox", { name: "Label" })).toBeTruthy();
+    expect(
+      screen.queryByRole("spinbutton", { name: "Initial tokens" }),
+    ).toBeNull();
+    expect(
+      screen.queryByRole("spinbutton", { name: "Current tokens" }),
+    ).toBeNull();
+  });
+
+  it("selecting an arc exposes Arc weight", () => {
+    const p = handle.model.addPlace(40, 40);
+    const t = handle.model.addTransition(160, 40);
+    handle.model.addArc(p.id, t.id, 1);
+    handle.render();
+    fireEvent.click(screen.getByRole("button", { name: /^Arc: .+ to .+$/ }));
+    expect(screen.getByRole("spinbutton", { name: "Arc weight" })).toBeTruthy();
+    expect(screen.queryByRole("textbox", { name: "Label" })).toBeNull();
+  });
+});
+
+describe("editField interaction", () => {
+  it("editing Current tokens flips a connected transition to enabled", () => {
+    const p = handle.model.addPlace(40, 40);
+    const t = handle.model.addTransition(160, 40);
+    handle.model.addArc(p.id, t.id, 1);
+    handle.render();
+
+    expect(
+      screen.getByRole("button", { name: /^Transition: .+ \(disabled\)$/ }),
+    ).toBeTruthy();
+
+    fireEvent.click(screen.getByRole("button", { name: /^Place: / }));
+    const field = screen.getByRole("spinbutton", { name: "Current tokens" });
+    fireEvent.input(field, { target: { value: "1" } });
+    fireEvent.change(field, { target: { value: "1" } });
+
+    expect(handle.model.getPlace(p.id)!.currentTokens).toBe(1);
+    expect(
+      screen.getByRole("button", { name: /^Transition: .+ \(enabled\)$/ }),
+    ).toBeTruthy();
+  });
+
+  it("editing Label updates the node's accessible name", () => {
+    fireEvent.click(screen.getByRole("button", { name: "Add place" }));
+    fireEvent.click(screen.getByRole("button", { name: /^Place: / }));
+    const field = screen.getByRole("textbox", { name: "Label" });
+    fireEvent.input(field, { target: { value: "Start" } });
+    fireEvent.change(field, { target: { value: "Start" } });
+    expect(screen.getByRole("button", { name: "Place: Start" })).toBeTruthy();
+  });
+});
+
+describe("fireTransition interaction", () => {
+  it("fires an enabled selected transition and reports via status", () => {
+    const p = handle.model.addPlace(40, 40);
+    p.currentTokens = 1;
+    const t = handle.model.addTransition(160, 40);
+    handle.model.addArc(p.id, t.id, 1);
+    handle.render();
+
+    fireEvent.click(screen.getByRole("button", { name: /^Transition: / }));
+    fireEvent.click(
+      screen.getByRole("button", { name: "Fire selected transition" }),
+    );
+
+    expect(handle.model.getPlace(p.id)!.currentTokens).toBe(0);
+    expect(screen.getByRole("status").textContent!.length).toBeGreaterThan(0);
+  });
+
+  it("raises an alert when firing a disabled transition and leaves tokens unchanged", () => {
+    const p = handle.model.addPlace(40, 40);
+    p.currentTokens = 0;
+    const t = handle.model.addTransition(160, 40);
+    handle.model.addArc(p.id, t.id, 1);
+    handle.render();
+
+    fireEvent.click(screen.getByRole("button", { name: /^Transition: / }));
+    fireEvent.click(
+      screen.getByRole("button", { name: "Fire selected transition" }),
+    );
+
+    expect(handle.model.getPlace(p.id)!.currentTokens).toBe(0);
+    expect(screen.getByRole("alert").textContent!.length).toBeGreaterThan(0);
+  });
+});
+
+describe("deleteSelection interaction", () => {
+  it("removes the selected node", () => {
+    fireEvent.click(screen.getByRole("button", { name: "Add place" }));
+    fireEvent.click(screen.getByRole("button", { name: /^Place: / }));
+    fireEvent.click(screen.getByRole("button", { name: "Delete selection" }));
+    expect(screen.queryByRole("button", { name: /^Place: / })).toBeNull();
+    expect(handle.model.places).toHaveLength(0);
+  });
+});
+
+describe("draw arc mode", () => {
+  it("toggles aria-pressed on the Draw arc control", () => {
+    const drawArc = screen.getByRole("button", { name: "Draw arc" });
+    expect(drawArc.getAttribute("aria-pressed")).toBe("false");
+    fireEvent.click(drawArc);
+    expect(drawArc.getAttribute("aria-pressed")).toBe("true");
+    fireEvent.click(drawArc);
+    expect(drawArc.getAttribute("aria-pressed")).toBe("false");
+  });
+});
+
+describe("new net (D3 confirmation)", () => {
+  it("does nothing when the confirmation is declined", () => {
+    fireEvent.click(screen.getByRole("button", { name: "Add place" }));
+    vi.spyOn(window, "confirm").mockReturnValue(false);
+    fireEvent.click(screen.getByRole("button", { name: "New net" }));
+    expect(handle.model.places).toHaveLength(1);
+  });
+
+  it("clears the net when the confirmation is accepted", () => {
+    fireEvent.click(screen.getByRole("button", { name: "Add place" }));
+    vi.spyOn(window, "confirm").mockReturnValue(true);
+    fireEvent.click(screen.getByRole("button", { name: "New net" }));
+    expect(handle.model.places).toHaveLength(0);
+    expect(screen.queryByRole("button", { name: /^Place: / })).toBeNull();
+  });
+});
+
+describe("reset marking", () => {
+  it("restores current tokens to initial tokens", () => {
+    const p = handle.model.addPlace(40, 40);
+    p.initialTokens = 3;
+    p.currentTokens = 0;
+    handle.render();
+    fireEvent.click(screen.getByRole("button", { name: "Reset marking" }));
+    expect(handle.model.getPlace(p.id)!.currentTokens).toBe(3);
+  });
+});
+
+describe("export JSON", () => {
+  it("does not throw and reports via status", () => {
+    handle.model.addPlace(40, 40);
+    handle.render();
+    // jsdom implements neither the object-URL APIs nor the anchor download
+    // navigation, so stub them to exercise the export path safely.
+    const createObjectURL = vi.fn(() => "blob:mock");
+    const revokeObjectURL = vi.fn();
+    (URL as unknown as { createObjectURL: unknown }).createObjectURL =
+      createObjectURL;
+    (URL as unknown as { revokeObjectURL: unknown }).revokeObjectURL =
+      revokeObjectURL;
+    const anchorClick = vi
+      .spyOn(HTMLAnchorElement.prototype, "click")
+      .mockImplementation(() => {});
+
+    fireEvent.click(screen.getByRole("button", { name: "Export JSON" }));
+
+    expect(createObjectURL).toHaveBeenCalled();
+    expect(anchorClick).toHaveBeenCalled();
+    expect(screen.getByRole("status").textContent!.length).toBeGreaterThan(0);
+  });
+});
diff --git a/tests/petri.test.ts b/tests/petri.test.ts
new file mode 100644
index 0000000..a5ca84a
--- /dev/null
+++ b/tests/petri.test.ts
@@ -0,0 +1,310 @@
+import { describe, it, expect } from "vitest";
+import { PetriNetModel } from "../src/petri";
+
+describe("node creation defaults", () => {
+  it("adds a place with initial and current tokens defaulting to 0", () => {
+    const net = new PetriNetModel();
+    const p = net.addPlace(10, 20);
+    expect(p.initialTokens).toBe(0);
+    expect(p.currentTokens).toBe(0);
+    expect(p.x).toBe(10);
+    expect(p.y).toBe(20);
+    expect(typeof p.id).toBe("string");
+    expect(p.label.length).toBeGreaterThan(0);
+    expect(net.places).toHaveLength(1);
+  });
+
+  it("adds a transition with coordinates and a label", () => {
+    const net = new PetriNetModel();
+    const t = net.addTransition(5, 6);
+    expect(t.x).toBe(5);
+    expect(t.y).toBe(6);
+    expect(typeof t.id).toBe("string");
+    expect(t.label.length).toBeGreaterThan(0);
+    expect(net.transitions).toHaveLength(1);
+  });
+
+  it("generates unique ids across many elements", () => {
+    const net = new PetriNetModel();
+    const ids = new Set<string>();
+    for (let i = 0; i < 50; i++) {
+      ids.add(net.addPlace(0, 0).id);
+      ids.add(net.addTransition(0, 0).id);
+    }
+    expect(ids.size).toBe(100);
+  });
+});
+
+describe("arc creation and INV1 (bipartite) validation", () => {
+  it("creates a place->transition arc with default weight 1", () => {
+    const net = new PetriNetModel();
+    const p = net.addPlace(0, 0);
+    const t = net.addTransition(0, 0);
+    const arc = net.addArc(p.id, t.id);
+    expect(arc).not.toBeNull();
+    expect(arc!.weight).toBe(1);
+    expect(net.arcs).toHaveLength(1);
+  });
+
+  it("creates a transition->place arc", () => {
+    const net = new PetriNetModel();
+    const p = net.addPlace(0, 0);
+    const t = net.addTransition(0, 0);
+    const arc = net.addArc(t.id, p.id);
+    expect(arc).not.toBeNull();
+    expect(net.arcs).toHaveLength(1);
+  });
+
+  it("blocks place->place arcs", () => {
+    const net = new PetriNetModel();
+    const a = net.addPlace(0, 0);
+    const b = net.addPlace(0, 0);
+    expect(net.addArc(a.id, b.id)).toBeNull();
+    expect(net.arcs).toHaveLength(0);
+  });
+
+  it("blocks transition->transition arcs", () => {
+    const net = new PetriNetModel();
+    const a = net.addTransition(0, 0);
+    const b = net.addTransition(0, 0);
+    expect(net.addArc(a.id, b.id)).toBeNull();
+    expect(net.arcs).toHaveLength(0);
+  });
+
+  it("blocks arcs referencing unknown nodes", () => {
+    const net = new PetriNetModel();
+    const p = net.addPlace(0, 0);
+    expect(net.addArc(p.id, "does-not-exist")).toBeNull();
+    expect(net.addArc("nope", p.id)).toBeNull();
+    expect(net.arcs).toHaveLength(0);
+  });
+
+  it("canConnect reflects INV1", () => {
+    const net = new PetriNetModel();
+    const p = net.addPlace(0, 0);
+    const t = net.addTransition(0, 0);
+    expect(net.canConnect(p.id, t.id)).toBe(true);
+    expect(net.canConnect(t.id, p.id)).toBe(true);
+    expect(net.canConnect(p.id, p.id)).toBe(false);
+  });
+});
+
+describe("firing semantics (standard P/T)", () => {
+  it("enables a transition when every input place has enough tokens", () => {
+    const net = new PetriNetModel();
+    const p = net.addPlace(0, 0);
+    p.currentTokens = 2;
+    const t = net.addTransition(0, 0);
+    net.addArc(p.id, t.id, 2);
+    expect(net.isEnabled(t.id)).toBe(true);
+  });
+
+  it("disables a transition when an input place lacks tokens", () => {
+    const net = new PetriNetModel();
+    const p = net.addPlace(0, 0);
+    p.currentTokens = 1;
+    const t = net.addTransition(0, 0);
+    net.addArc(p.id, t.id, 2);
+    expect(net.isEnabled(t.id)).toBe(false);
+  });
+
+  it("treats a transition with no input places as enabled", () => {
+    const net = new PetriNetModel();
+    const t = net.addTransition(0, 0);
+    expect(net.isEnabled(t.id)).toBe(true);
+  });
+
+  it("moves tokens from inputs to outputs when fired", () => {
+    const net = new PetriNetModel();
+    const pin = net.addPlace(0, 0);
+    pin.currentTokens = 3;
+    const pout = net.addPlace(0, 0);
+    pout.currentTokens = 0;
+    const t = net.addTransition(0, 0);
+    net.addArc(pin.id, t.id, 2);
+    net.addArc(t.id, pout.id, 1);
+    expect(net.fire(t.id)).toBe(true);
+    expect(pin.currentTokens).toBe(1);
+    expect(pout.currentTokens).toBe(1);
+  });
+
+  it("does not fire or mutate tokens when the transition is disabled", () => {
+    const net = new PetriNetModel();
+    const pin = net.addPlace(0, 0);
+    pin.currentTokens = 1;
+    const t = net.addTransition(0, 0);
+    net.addArc(pin.id, t.id, 2);
+    expect(net.fire(t.id)).toBe(false);
+    expect(pin.currentTokens).toBe(1);
+  });
+
+  it("supports self-loops using current-marking semantics", () => {
+    // A place that is both input (weight 1) and output (weight 1) of t:
+    // enabled requires 1 token; after firing the marking is unchanged.
+    const net = new PetriNetModel();
+    const p = net.addPlace(0, 0);
+    p.currentTokens = 1;
+    const t = net.addTransition(0, 0);
+    net.addArc(p.id, t.id, 1);
+    net.addArc(t.id, p.id, 1);
+    expect(net.isEnabled(t.id)).toBe(true);
+    expect(net.fire(t.id)).toBe(true);
+    expect(p.currentTokens).toBe(1);
+  });
+});
+
+describe("deletion", () => {
+  it("cascades arc deletion when a place is deleted", () => {
+    const net = new PetriNetModel();
+    const p = net.addPlace(0, 0);
+    const t = net.addTransition(0, 0);
+    net.addArc(p.id, t.id);
+    net.deleteNode(p.id);
+    expect(net.places).toHaveLength(0);
+    expect(net.arcs).toHaveLength(0);
+    expect(net.transitions).toHaveLength(1);
+  });
+
+  it("cascades arc deletion when a transition is deleted", () => {
+    const net = new PetriNetModel();
+    const p = net.addPlace(0, 0);
+    const t = net.addTransition(0, 0);
+    net.addArc(p.id, t.id);
+    net.addArc(t.id, p.id);
+    net.deleteNode(t.id);
+    expect(net.transitions).toHaveLength(0);
+    expect(net.arcs).toHaveLength(0);
+    expect(net.places).toHaveLength(1);
+  });
+
+  it("deletes only the arc when an arc is deleted", () => {
+    const net = new PetriNetModel();
+    const p = net.addPlace(0, 0);
+    const t = net.addTransition(0, 0);
+    const arc = net.addArc(p.id, t.id)!;
+    net.deleteArc(arc.id);
+    expect(net.arcs).toHaveLength(0);
+    expect(net.places).toHaveLength(1);
+    expect(net.transitions).toHaveLength(1);
+  });
+});
+
+describe("reset marking", () => {
+  it("restores current tokens to initial tokens", () => {
+    const net = new PetriNetModel();
+    const p = net.addPlace(0, 0);
+    p.initialTokens = 5;
+    p.currentTokens = 0;
+    net.resetMarking();
+    expect(p.currentTokens).toBe(5);
+  });
+});
+
+describe("JSON export/import (REQ12)", () => {
+  it("exports the documented schema without currentTokens", () => {
+    const net = new PetriNetModel();
+    const p = net.addPlace(1, 2);
+    p.label = "P1";
+    p.initialTokens = 3;
+    p.currentTokens = 1;
+    const t = net.addTransition(4, 5);
+    t.label = "T1";
+    net.addArc(p.id, t.id, 2);
+
+    const json = net.toJSON();
+    expect(json.places[0]).toEqual({
+      id: p.id,
+      label: "P1",
+      x: 1,
+      y: 2,
+      initialTokens: 3,
+    });
+    expect(json.places[0]).not.toHaveProperty("currentTokens");
+    expect(json.transitions[0]).toEqual({ id: t.id, label: "T1", x: 4, y: 5 });
+    expect(json.arcs[0]).toMatchObject({ source: p.id, target: t.id, weight: 2 });
+    expect(typeof json.arcs[0].id).toBe("string");
+  });
+
+  it("imports a net and restores current tokens from initial tokens", () => {
+    const data = {
+      places: [{ id: "p1", label: "P1", x: 1, y: 2, initialTokens: 4 }],
+      transitions: [{ id: "t1", label: "T1", x: 3, y: 4 }],
+      arcs: [{ id: "a1", source: "p1", target: "t1", weight: 2 }],
+    };
+    const net = PetriNetModel.fromJSON(data);
+    expect(net.places[0].currentTokens).toBe(4);
+    expect(net.places[0].initialTokens).toBe(4);
+    expect(net.arcs).toHaveLength(1);
+  });
+
+  it("round-trips export -> import preserving structure", () => {
+    const net = new PetriNetModel();
+    const p = net.addPlace(10, 20);
+    p.initialTokens = 2;
+    const t = net.addTransition(30, 40);
+    net.addArc(p.id, t.id, 3);
+    const restored = PetriNetModel.fromJSON(net.toJSON());
+    expect(restored.places).toHaveLength(1);
+    expect(restored.transitions).toHaveLength(1);
+    expect(restored.arcs).toHaveLength(1);
+    expect(restored.places[0].currentTokens).toBe(2);
+    expect(restored.arcs[0].weight).toBe(3);
+  });
+
+  it("assigns fresh ids that do not collide with imported ids", () => {
+    const net = PetriNetModel.fromJSON({
+      places: [{ id: "p1", label: "P1", x: 0, y: 0, initialTokens: 0 }],
+      transitions: [],
+      arcs: [],
+    });
+    const seen = new Set(net.places.map((p) => p.id));
+    for (let i = 0; i < 20; i++) {
+      const created = net.addPlace(0, 0);
+      expect(seen.has(created.id)).toBe(false);
+      seen.add(created.id);
+    }
+  });
+
+  it("throws on non-object input (malformed)", () => {
+    expect(() => PetriNetModel.fromJSON(null)).toThrow();
+    expect(() => PetriNetModel.fromJSON("nope" as unknown)).toThrow();
+    expect(() => PetriNetModel.fromJSON(42 as unknown)).toThrow();
+  });
+
+  it("throws when required arrays are missing or wrong type", () => {
+    expect(() => PetriNetModel.fromJSON({})).toThrow();
+    expect(() =>
+      PetriNetModel.fromJSON({ places: {}, transitions: [], arcs: [] }),
+    ).toThrow();
+  });
+
+  it("throws when an element is missing required fields", () => {
+    expect(() =>
+      PetriNetModel.fromJSON({
+        places: [{ id: "p1" }],
+        transitions: [],
+        arcs: [],
+      }),
+    ).toThrow();
+  });
+
+  it("throws when an arc violates INV1 or references unknown nodes", () => {
+    expect(() =>
+      PetriNetModel.fromJSON({
+        places: [
+          { id: "p1", label: "P1", x: 0, y: 0, initialTokens: 0 },
+          { id: "p2", label: "P2", x: 0, y: 0, initialTokens: 0 },
+        ],
+        transitions: [],
+        arcs: [{ id: "a1", source: "p1", target: "p2", weight: 1 }],
+      }),
+    ).toThrow();
+    expect(() =>
+      PetriNetModel.fromJSON({
+        places: [{ id: "p1", label: "P1", x: 0, y: 0, initialTokens: 0 }],
+        transitions: [],
+        arcs: [{ id: "a1", source: "p1", target: "ghost", weight: 1 }],
+      }),
+    ).toThrow();
+  });
+});
