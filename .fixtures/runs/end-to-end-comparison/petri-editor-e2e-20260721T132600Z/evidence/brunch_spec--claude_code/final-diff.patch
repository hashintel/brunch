diff --git a/src/app.ts b/src/app.ts
new file mode 100644
index 0000000..45e1e31
--- /dev/null
+++ b/src/app.ts
@@ -0,0 +1,591 @@
+import { PetriNetModel } from "./petri";
+
+export interface AppHandle {
+  readonly model: PetriNetModel;
+  render(): void;
+}
+
+type Selection =
+  | { kind: "place" | "transition" | "arc"; id: string }
+  | null;
+
+const PLACE_R = 26;
+const TRANS = 46;
+const TRANS_R = 28;
+
+const CONTROLS: Array<{ action: string; name: string }> = [
+  { action: "add-place", name: "Add place" },
+  { action: "add-transition", name: "Add transition" },
+  { action: "draw-arc", name: "Draw arc" },
+  { action: "fire", name: "Fire selected transition" },
+  { action: "delete", name: "Delete selection" },
+  { action: "new", name: "New net" },
+  { action: "reset", name: "Reset marking" },
+  { action: "export", name: "Export JSON" },
+  { action: "import", name: "Import JSON" },
+];
+
+export function mountApp(root: HTMLElement): AppHandle {
+  let model = new PetriNetModel();
+  let selection: Selection = null;
+  let drawArc = false;
+
+  // ---- static structure ---------------------------------------------------
+  const app = el("div", { class: "app" });
+  app.setAttribute("role", "application");
+  app.setAttribute("aria-label", "Petri net editor");
+
+  const toolbar = el("div", { class: "toolbar" });
+  const actionButtons = new Map<string, HTMLButtonElement>();
+  for (const { action, name } of CONTROLS) {
+    const btn = el("button", { type: "button", class: "control" }) as HTMLButtonElement;
+    btn.textContent = name;
+    btn.dataset.action = action;
+    if (action === "draw-arc") btn.setAttribute("aria-pressed", "false");
+    btn.addEventListener("click", () => handleAction(action));
+    actionButtons.set(action, btn);
+    toolbar.appendChild(btn);
+  }
+
+  // Hidden file input for JSON import. aria-hidden keeps it out of the
+  // accessibility tree so the visible "Import JSON" button is the only
+  // control with that name; it is still fully usable via setInputFiles or
+  // a file-chooser triggered by the button.
+  const fileInput = el("input", {
+    type: "file",
+    class: "file-input",
+    accept: "application/json,.json",
+  }) as HTMLInputElement;
+  fileInput.setAttribute("aria-hidden", "true");
+  fileInput.tabIndex = -1;
+  fileInput.addEventListener("change", handleImportFile);
+  toolbar.appendChild(fileInput);
+
+  const workspace = el("div", { class: "workspace" });
+  const canvas = el("div", { class: "canvas" });
+  canvas.setAttribute("role", "region");
+  canvas.setAttribute("aria-label", "Petri net canvas");
+  canvas.addEventListener("pointerdown", (e) => {
+    if (e.target === canvas || (e.target as Element).classList.contains("edges")) {
+      setSelection(null);
+    }
+  });
+
+  const inspector = el("aside", { class: "inspector" });
+  inspector.setAttribute("aria-label", "Inspector");
+
+  workspace.appendChild(canvas);
+  workspace.appendChild(inspector);
+
+  const feedback = el("div", { class: "feedback" });
+  const statusEl = el("div", { class: "status" });
+  statusEl.setAttribute("role", "status");
+  statusEl.setAttribute("aria-live", "polite");
+  const alertEl = el("div", { class: "alert" });
+  alertEl.setAttribute("role", "alert");
+  alertEl.setAttribute("aria-live", "assertive");
+  feedback.appendChild(statusEl);
+  feedback.appendChild(alertEl);
+
+  app.appendChild(toolbar);
+  app.appendChild(workspace);
+  app.appendChild(feedback);
+  root.appendChild(app);
+
+  // ---- feedback -----------------------------------------------------------
+  function setStatus(msg: string): void {
+    statusEl.textContent = msg;
+    alertEl.textContent = "";
+  }
+  function setAlert(msg: string): void {
+    alertEl.textContent = msg;
+    statusEl.textContent = "";
+  }
+
+  // ---- selection ----------------------------------------------------------
+  function setSelection(next: Selection): void {
+    selection = next;
+    render();
+  }
+
+  function setDrawArc(on: boolean): void {
+    drawArc = on;
+    actionButtons.get("draw-arc")!.setAttribute("aria-pressed", String(on));
+  }
+
+  // ---- spawning -----------------------------------------------------------
+  function nextSpawn(): { x: number; y: number } {
+    const index = model.places.length + model.transitions.length;
+    return {
+      x: 70 + (index % 6) * 90,
+      y: 70 + (Math.floor(index / 6) % 4) * 90,
+    };
+  }
+
+  // ---- actions ------------------------------------------------------------
+  function handleAction(action: string): void {
+    switch (action) {
+      case "add-place": {
+        const { x, y } = nextSpawn();
+        const p = model.addPlace(x, y);
+        render();
+        setStatus(`Added place ${p.label}.`);
+        break;
+      }
+      case "add-transition": {
+        const { x, y } = nextSpawn();
+        const t = model.addTransition(x, y);
+        render();
+        setStatus(`Added transition ${t.label}.`);
+        break;
+      }
+      case "draw-arc": {
+        setDrawArc(!drawArc);
+        setStatus(drawArc ? "Draw arc: drag from a source node to a target node." : "Draw arc mode off.");
+        break;
+      }
+      case "fire":
+        fireSelected();
+        break;
+      case "delete":
+        deleteSelected();
+        break;
+      case "new":
+        newNet();
+        break;
+      case "reset":
+        model.resetMarking();
+        render();
+        setStatus("Marking reset to initial tokens.");
+        break;
+      case "export":
+        exportJson();
+        break;
+      case "import":
+        fileInput.click();
+        break;
+    }
+  }
+
+  function fireSelected(): void {
+    if (!selection || selection.kind !== "transition") {
+      setAlert("Select a transition to fire.");
+      return;
+    }
+    const t = model.getTransition(selection.id);
+    if (!t) return;
+    if (!model.isEnabled(t.id)) {
+      setAlert(`Transition ${t.label} is not enabled and cannot fire.`);
+      return;
+    }
+    model.fire(t.id);
+    render();
+    setStatus(`Fired transition ${t.label}.`);
+  }
+
+  function deleteSelected(): void {
+    if (!selection) {
+      setAlert("Nothing is selected to delete.");
+      return;
+    }
+    if (selection.kind === "arc") {
+      model.deleteArc(selection.id);
+    } else {
+      model.deleteNode(selection.id);
+    }
+    selection = null;
+    render();
+    setStatus("Deleted selection.");
+  }
+
+  function newNet(): void {
+    const ok = window.confirm(
+      "Discard the current net and start a new one? Unsaved changes will be lost.",
+    );
+    if (!ok) return;
+    model.clear();
+    selection = null;
+    setDrawArc(false);
+    render();
+    setStatus("Started a new net.");
+  }
+
+  function exportJson(): void {
+    const text = JSON.stringify(model.toJSON(), null, 2);
+    const blob = new Blob([text], { type: "application/json" });
+    const url = URL.createObjectURL(blob);
+    const a = el("a", { href: url, download: "petri-net.json" }) as HTMLAnchorElement;
+    document.body.appendChild(a);
+    a.click();
+    a.remove();
+    URL.revokeObjectURL(url);
+    setStatus("Exported net as JSON.");
+  }
+
+  function handleImportFile(): void {
+    const file = fileInput.files && fileInput.files[0];
+    if (!file) return;
+    file
+      .text()
+      .then((text) => {
+        let data: unknown;
+        try {
+          data = JSON.parse(text);
+        } catch {
+          throw new Error("file is not valid JSON.");
+        }
+        model = PetriNetModel.fromJSON(data);
+        selection = null;
+        setDrawArc(false);
+        render();
+        setStatus("Imported net.");
+      })
+      .catch((err: unknown) => {
+        const message = err instanceof Error ? err.message : "invalid file.";
+        setAlert(`Import failed: ${message}`);
+      })
+      .finally(() => {
+        fileInput.value = "";
+      });
+  }
+
+  // ---- pointer interactions ----------------------------------------------
+  function canvasPoint(e: PointerEvent): { x: number; y: number } {
+    const rect = canvas.getBoundingClientRect();
+    return { x: e.clientX - rect.left, y: e.clientY - rect.top };
+  }
+
+  function onNodePointerDown(e: PointerEvent, id: string): void {
+    e.preventDefault();
+    e.stopPropagation();
+    if (drawArc) {
+      startArcDrag(id);
+    } else {
+      startMoveDrag(e, id);
+    }
+  }
+
+  function selectNode(kind: "place" | "transition", id: string): void {
+    // A plain activation (click) selects; drag gestures are handled by the
+    // pointer handlers and must not also trigger selection while drawing arcs.
+    if (!drawArc) setSelection({ kind, id });
+  }
+
+  function startMoveDrag(e: PointerEvent, id: string): void {
+    const node = model.getPlace(id) ?? model.getTransition(id);
+    if (!node) return;
+    const start = canvasPoint(e);
+    const offX = start.x - node.x;
+    const offY = start.y - node.y;
+    const onMove = (ev: PointerEvent) => {
+      const p = canvasPoint(ev);
+      model.moveNode(id, p.x - offX, p.y - offY);
+      renderScene();
+    };
+    const onUp = () => {
+      window.removeEventListener("pointermove", onMove);
+      renderScene();
+    };
+    window.addEventListener("pointermove", onMove);
+    window.addEventListener("pointerup", onUp, { once: true });
+  }
+
+  function startArcDrag(sourceId: string): void {
+    const svg = canvas.querySelector("svg.edges");
+    const temp = document.createElementNS("http://www.w3.org/2000/svg", "line");
+    temp.setAttribute("class", "temp-arc");
+    const src = model.getPlace(sourceId) ?? model.getTransition(sourceId)!;
+    temp.setAttribute("x1", String(src.x));
+    temp.setAttribute("y1", String(src.y));
+    temp.setAttribute("x2", String(src.x));
+    temp.setAttribute("y2", String(src.y));
+    svg?.appendChild(temp);
+
+    const onMove = (ev: PointerEvent) => {
+      const p = canvasPoint(ev);
+      temp.setAttribute("x2", String(p.x));
+      temp.setAttribute("y2", String(p.y));
+    };
+    const onUp = (ev: PointerEvent) => {
+      window.removeEventListener("pointermove", onMove);
+      temp.remove();
+      const el0 = document.elementFromPoint(ev.clientX, ev.clientY);
+      const targetEl = el0 ? el0.closest("[data-node-id]") : null;
+      const targetId = targetEl?.getAttribute("data-node-id") ?? null;
+      finishArc(sourceId, targetId);
+    };
+    window.addEventListener("pointermove", onMove);
+    window.addEventListener("pointerup", onUp, { once: true });
+  }
+
+  function finishArc(sourceId: string, targetId: string | null): void {
+    if (!targetId || targetId === sourceId) {
+      render();
+      return;
+    }
+    if (!model.canConnect(sourceId, targetId)) {
+      setAlert(
+        "Cannot create arc: arcs must connect a place and a transition (INV1).",
+      );
+      render();
+      return;
+    }
+    model.addArc(sourceId, targetId, 1);
+    setDrawArc(false);
+    render();
+    setStatus(
+      `Added arc ${model.labelOf(sourceId)} to ${model.labelOf(targetId)}.`,
+    );
+  }
+
+  // ---- rendering ----------------------------------------------------------
+  function render(): void {
+    renderScene();
+    renderInspector();
+  }
+
+  function renderScene(): void {
+    canvas.innerHTML = "";
+    const svg = document.createElementNS("http://www.w3.org/2000/svg", "svg");
+    svg.setAttribute("class", "edges");
+    svg.innerHTML =
+      '<defs><marker id="arrowhead" markerWidth="10" markerHeight="8" refX="9" refY="4" orient="auto">' +
+      '<path d="M0,0 L10,4 L0,8 z" fill="currentColor"/></marker></defs>';
+    canvas.appendChild(svg);
+
+    for (const arc of model.arcs) {
+      const src = nodeById(arc.source);
+      const tgt = nodeById(arc.target);
+      if (!src || !tgt) continue;
+      const geo = trim(src, tgt);
+      const line = document.createElementNS("http://www.w3.org/2000/svg", "line");
+      line.setAttribute("class", "arc-line");
+      line.setAttribute("x1", String(geo.x1));
+      line.setAttribute("y1", String(geo.y1));
+      line.setAttribute("x2", String(geo.x2));
+      line.setAttribute("y2", String(geo.y2));
+      line.setAttribute("marker-end", "url(#arrowhead)");
+      svg.appendChild(line);
+    }
+
+    for (const arc of model.arcs) {
+      const src = nodeById(arc.source);
+      const tgt = nodeById(arc.target);
+      if (!src || !tgt) continue;
+      const mx = (src.x + tgt.x) / 2;
+      const my = (src.y + tgt.y) / 2;
+      const handle = el("button", { type: "button", class: "arc-handle" }) as HTMLButtonElement;
+      const selected = selection?.kind === "arc" && selection.id === arc.id;
+      if (selected) handle.classList.add("selected");
+      handle.dataset.arcId = arc.id;
+      handle.setAttribute(
+        "aria-label",
+        `Arc: ${model.labelOf(arc.source)} to ${model.labelOf(arc.target)}`,
+      );
+      handle.textContent = String(arc.weight);
+      handle.style.left = `${mx - 12}px`;
+      handle.style.top = `${my - 12}px`;
+      handle.addEventListener("pointerdown", (e) => e.stopPropagation());
+      handle.addEventListener("click", (e) => {
+        e.stopPropagation();
+        setSelection({ kind: "arc", id: arc.id });
+      });
+      canvas.appendChild(handle);
+    }
+
+    for (const p of model.places) {
+      const btn = el("button", { type: "button", class: "node place" }) as HTMLButtonElement;
+      if (selection?.kind === "place" && selection.id === p.id) {
+        btn.classList.add("selected");
+      }
+      btn.dataset.nodeId = p.id;
+      btn.setAttribute("aria-label", `Place: ${p.label}`);
+      btn.style.left = `${p.x - PLACE_R}px`;
+      btn.style.top = `${p.y - PLACE_R}px`;
+      btn.style.width = `${PLACE_R * 2}px`;
+      btn.style.height = `${PLACE_R * 2}px`;
+      const tokens = el("span", { class: "tokens" });
+      tokens.textContent = String(p.currentTokens);
+      const label = el("span", { class: "node-label" });
+      label.textContent = p.label;
+      btn.appendChild(tokens);
+      btn.appendChild(label);
+      btn.addEventListener("pointerdown", (e) => onNodePointerDown(e, p.id));
+      btn.addEventListener("click", () => selectNode("place", p.id));
+      canvas.appendChild(btn);
+    }
+
+    for (const t of model.transitions) {
+      const enabled = model.isEnabled(t.id);
+      const btn = el("button", { type: "button", class: "node transition" }) as HTMLButtonElement;
+      btn.classList.add(enabled ? "enabled" : "disabled");
+      if (selection?.kind === "transition" && selection.id === t.id) {
+        btn.classList.add("selected");
+      }
+      btn.dataset.nodeId = t.id;
+      btn.setAttribute(
+        "aria-label",
+        `Transition: ${t.label} (${enabled ? "enabled" : "disabled"})`,
+      );
+      btn.style.left = `${t.x - TRANS / 2}px`;
+      btn.style.top = `${t.y - TRANS / 2}px`;
+      btn.style.width = `${TRANS}px`;
+      btn.style.height = `${TRANS}px`;
+      const label = el("span", { class: "node-label" });
+      label.textContent = t.label;
+      btn.appendChild(label);
+      btn.addEventListener("pointerdown", (e) => onNodePointerDown(e, t.id));
+      btn.addEventListener("click", () => selectNode("transition", t.id));
+      canvas.appendChild(btn);
+    }
+  }
+
+  function renderInspector(): void {
+    inspector.innerHTML = "";
+    const heading = el("h2", { class: "inspector-title" });
+    heading.textContent = "Properties";
+    inspector.appendChild(heading);
+
+    if (!selection) {
+      const hint = el("p", { class: "hint" });
+      hint.textContent = "Select a place, transition, or arc to edit it.";
+      inspector.appendChild(hint);
+      return;
+    }
+
+    if (selection.kind === "place") {
+      const p = model.getPlace(selection.id);
+      if (!p) return;
+      inspector.appendChild(
+        textField("Label", p.label, (v) => {
+          const s = v.trim();
+          if (s) p.label = s;
+        }),
+      );
+      inspector.appendChild(
+        numberField("Initial tokens", p.initialTokens, 0, (n) => {
+          p.initialTokens = n;
+        }),
+      );
+      inspector.appendChild(
+        numberField("Current tokens", p.currentTokens, 0, (n) => {
+          p.currentTokens = n;
+        }),
+      );
+    } else if (selection.kind === "transition") {
+      const t = model.getTransition(selection.id);
+      if (!t) return;
+      inspector.appendChild(
+        textField("Label", t.label, (v) => {
+          const s = v.trim();
+          if (s) t.label = s;
+        }),
+      );
+    } else {
+      const arc = model.getArc(selection.id);
+      if (!arc) return;
+      inspector.appendChild(
+        numberField("Arc weight", arc.weight, 1, (n) => {
+          arc.weight = n;
+        }),
+      );
+    }
+  }
+
+  function textField(
+    name: string,
+    value: string,
+    commit: (v: string) => void,
+  ): HTMLElement {
+    const { label, input } = fieldShell(name, "text");
+    input.value = value;
+    const apply = () => {
+      commit(input.value);
+      renderScene();
+    };
+    input.addEventListener("input", apply);
+    input.addEventListener("change", apply);
+    return label;
+  }
+
+  function numberField(
+    name: string,
+    value: number,
+    min: number,
+    commit: (n: number) => void,
+  ): HTMLElement {
+    const { label, input } = fieldShell(name, "number");
+    input.min = String(min);
+    input.step = "1";
+    input.value = String(value);
+    const apply = () => {
+      const parsed = Math.floor(Number(input.value));
+      const n = Number.isFinite(parsed) ? Math.max(min, parsed) : min;
+      commit(n);
+      renderScene();
+    };
+    input.addEventListener("input", apply);
+    input.addEventListener("change", apply);
+    return label;
+  }
+
+  function fieldShell(name: string, type: string) {
+    const label = el("label", { class: "field" });
+    const span = el("span", { class: "field-name" });
+    span.textContent = name;
+    const input = el("input", { type }) as HTMLInputElement;
+    input.setAttribute("aria-label", name);
+    label.appendChild(span);
+    label.appendChild(input);
+    return { label, input };
+  }
+
+  // ---- helpers ------------------------------------------------------------
+  function nodeById(id: string) {
+    return model.getPlace(id) ?? model.getTransition(id);
+  }
+
+  function trim(
+    src: { x: number; y: number },
+    tgt: { x: number; y: number },
+  ): { x1: number; y1: number; x2: number; y2: number } {
+    const dx = tgt.x - src.x;
+    const dy = tgt.y - src.y;
+    const len = Math.hypot(dx, dy) || 1;
+    const ux = dx / len;
+    const uy = dy / len;
+    const sr = radiusOf(src);
+    const tr = radiusOf(tgt);
+    return {
+      x1: src.x + ux * sr,
+      y1: src.y + uy * sr,
+      x2: tgt.x - ux * tr,
+      y2: tgt.y - uy * tr,
+    };
+  }
+
+  function radiusOf(node: { x: number; y: number }): number {
+    const id = (node as { id?: string }).id;
+    if (id && model.getTransition(id)) return TRANS_R;
+    return PLACE_R;
+  }
+
+  const handle: AppHandle = {
+    get model() {
+      return model;
+    },
+    render,
+  };
+
+  render();
+  return handle;
+}
+
+function el(tag: string, attrs: Record<string, string> = {}): HTMLElement {
+  const node = document.createElement(tag);
+  for (const [k, v] of Object.entries(attrs)) {
+    if (k === "class") node.className = v;
+    else node.setAttribute(k, v);
+  }
+  return node;
+}
