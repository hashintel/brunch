+
+  it("editing the Label field via change updates the node name", () => {
+    click("Add place");
+    const label = getByRole(container, "textbox", { name: "Label" }) as HTMLInputElement;
+    label.value = "Start";
+    fireEvent.change(label);
+    expect(getByRole(container, "button", { name: "Place: Start" })).toBeTruthy();
+  });
+
+  it("editing Current tokens via change updates the model", () => {
+    click("Add place");
+    const cur = getByRole(container, "spinbutton", { name: "Current tokens" }) as HTMLInputElement;
+    cur.value = "3";
+    fireEvent.change(cur);
+    expect(store.getState().net.places[0].currentTokens).toBe(3);
+  });
+
+  it("rejected token edit reverts the input and alerts", () => {
+    click("Add place");
+    const cur = getByRole(container, "spinbutton", { name: "Current tokens" }) as HTMLInputElement;
+    cur.value = "-5";
+    fireEvent.change(cur);
+    expect(getByRole(container, "alert").textContent).toBe("Tokens must be a non-negative integer.");
+    expect(store.getState().net.places[0].currentTokens).toBe(0);
+  });
+});
+
+describe("§8.1 arc drawing interaction", () => {
+  it("two-click drawing creates exactly one arc", () => {
+    click("Add place");
+    click("Add transition");
+    click("Draw arc");
+    fireEvent.click(getByRole(container, "button", { name: "Place: P1" }));
+    fireEvent.click(getByRole(container, "button", { name: /^Transition: T1/ }));
+    expect(queryAllByRole(container, "button", { name: /^Arc: / }).length).toBe(1);
