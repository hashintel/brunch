+
+function click(name: string | RegExp) {
+  fireEvent.click(getByRole(container, "button", { name }));
+}
+
+describe("§2/§9 landmarks and regions", () => {
+  it("root exposes the application name and the canvas region", () => {
+    expect(getByRole(container, "application", { name: "Petri net editor" })).toBeTruthy();
+    expect(getByRole(container, "region", { name: "Petri net canvas" })).toBeTruthy();
+  });
+
+  it("all nine baseline controls exist with matching accessible names", () => {
+    for (const name of CONTROL_NAMES) {
+      expect(getByRole(container, "button", { name })).toBeTruthy();
+    }
+  });
+
+  it("status and alert live regions exist", () => {
+    expect(getByRole(container, "status")).toBeTruthy();
+    expect(getByRole(container, "alert")).toBeTruthy();
+  });
+});
+
+describe("§12 dynamic accessible names", () => {
+  it("creating a place yields a node named 'Place: P1'", () => {
+    click("Add place");
+    expect(getByRole(container, "button", { name: "Place: P1" })).toBeTruthy();
+  });
+
+  it("a fresh transition is enabled and becomes disabled once starved", () => {
+    click("Add transition");
+    expect(getByRole(container, "button", { name: "Transition: T1 (enabled)" })).toBeTruthy();
+
+    click("Add place"); // P1 with 0 tokens
+    // arc P1 -> T1 via two-click
+    click("Draw arc");
