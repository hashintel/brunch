diff --git a/src/model.ts b/src/model.ts
new file mode 100644
index 0000000..4f135cb
--- /dev/null
+++ b/src/model.ts
@@ -0,0 +1,343 @@
+import type { Arc, Net, NodeId, Place, Transition } from "./types";
+
+const MAX = Number.MAX_SAFE_INTEGER;
+
+/** Thrown for every model-level rejection; the message is user-facing. */
+export class ValidationError extends Error {
+  constructor(message: string) {
+    super(message);
+    this.name = "ValidationError";
+  }
+}
+
+export function emptyNet(): Net {
+  return { schemaVersion: 1, places: [], transitions: [], arcs: [] };
+}
+
+let idCounter = 0;
+export function genId(prefix: string): string {
+  const c = (globalThis as { crypto?: Crypto }).crypto;
+  if (c && typeof c.randomUUID === "function") return `${prefix}-${c.randomUUID()}`;
+  idCounter += 1;
+  return `${prefix}-${Date.now().toString(36)}-${idCounter.toString(36)}`;
+}
+
+/** Lowest positive integer suffix not already used within the kind. */
+export function nextLabel(prefix: "P" | "T", existing: string[]): string {
+  const used = new Set(existing);
+  let n = 1;
+  while (used.has(`${prefix}${n}`)) n += 1;
+  return `${prefix}${n}`;
+}
+
+export function nodeKind(net: Net, id: NodeId): "place" | "transition" | null {
+  if (net.places.some((p) => p.id === id)) return "place";
+  if (net.transitions.some((t) => t.id === id)) return "transition";
+  return null;
+}
+
+export function labelOf(net: Net, id: NodeId): string {
+  const p = net.places.find((n) => n.id === id);
+  if (p) return p.label;
+  const t = net.transitions.find((n) => n.id === id);
+  return t ? t.label : id;
+}
+
+export function addPlace(net: Net, x: number, y: number): { net: Net; id: NodeId } {
+  const label = nextLabel(
+    "P",
+    net.places.map((p) => p.label),
+  );
+  const place: Place = { id: genId("p"), label, x, y, initialTokens: 0, currentTokens: 0 };
+  return { net: { ...net, places: [...net.places, place] }, id: place.id };
+}
+
+export function addTransition(net: Net, x: number, y: number): { net: Net; id: NodeId } {
+  const label = nextLabel(
+    "T",
+    net.transitions.map((t) => t.label),
+  );
+  const transition: Transition = { id: genId("t"), label, x, y };
+  return { net: { ...net, transitions: [...net.transitions, transition] }, id: transition.id };
+}
+
+/** V1 + V2. Creates an arc with weight 1. Throws ValidationError on rejection. */
+export function addArc(net: Net, sourceId: NodeId, targetId: NodeId): Net {
+  const sk = nodeKind(net, sourceId);
+  const tk = nodeKind(net, targetId);
+  if (sk === null || tk === null || sk === tk) {
+    throw new ValidationError("Arcs must connect a place to a transition.");
+  }
+  if (net.arcs.some((a) => a.sourceId === sourceId && a.targetId === targetId)) {
+    throw new ValidationError(
+      `An arc from ${labelOf(net, sourceId)} to ${labelOf(net, targetId)} already exists.`,
+    );
+  }
+  const arc: Arc = { id: genId("a"), sourceId, targetId, weight: 1 };
+  return { ...net, arcs: [...net.arcs, arc] };
+}
+
+export function inputArcs(net: Net, transitionId: NodeId): Arc[] {
+  return net.arcs.filter((a) => a.targetId === transitionId);
+}
+
+export function outputArcs(net: Net, transitionId: NodeId): Arc[] {
+  return net.arcs.filter((a) => a.sourceId === transitionId);
+}
+
+export function isEnabled(net: Net, transitionId: NodeId): boolean {
+  for (const a of inputArcs(net, transitionId)) {
+    const p = net.places.find((n) => n.id === a.sourceId);
+    if (p && p.currentTokens < a.weight) return false;
+  }
+  return true;
+}
+
+export function fire(net: Net, transitionId: NodeId): Net {
+  if (!isEnabled(net, transitionId)) return net;
+  const places = net.places.map((p) => ({ ...p }));
+  const byId = new Map(places.map((p) => [p.id, p]));
+  for (const a of inputArcs(net, transitionId)) {
+    const p = byId.get(a.sourceId);
+    if (p) p.currentTokens -= a.weight;
+  }
+  for (const a of outputArcs(net, transitionId)) {
+    const p = byId.get(a.targetId);
+    if (p) p.currentTokens += a.weight;
+  }
+  return { ...net, places };
+}
+
+export function deleteNode(net: Net, id: NodeId): { net: Net; removedArcs: number } {
+  const keptArcs = net.arcs.filter((a) => a.sourceId !== id && a.targetId !== id);
+  return {
+    net: {
+      ...net,
+      places: net.places.filter((p) => p.id !== id),
+      transitions: net.transitions.filter((t) => t.id !== id),
+      arcs: keptArcs,
+    },
+    removedArcs: net.arcs.length - keptArcs.length,
+  };
+}
+
+export function deleteArc(net: Net, id: string): { net: Net; arc: Arc | undefined } {
+  const arc = net.arcs.find((a) => a.id === id);
+  return { net: { ...net, arcs: net.arcs.filter((a) => a.id !== id) }, arc };
+}
+
+export function resetMarking(net: Net): Net {
+  return {
+    ...net,
+    places: net.places.map((p) => ({ ...p, currentTokens: p.initialTokens })),
+  };
+}
+
+export function setLabel(net: Net, id: NodeId, raw: string): Net {
+  const kind = nodeKind(net, id);
+  const word = kind === "transition" ? "transitions" : "places";
+  const label = raw.trim();
+  const reject = () =>
+    new ValidationError(`Label must be non-empty and unique among ${word}.`);
+  if (kind === null || label === "") throw reject();
+  if (kind === "place") {
+    if (net.places.some((p) => p.id !== id && p.label === label)) throw reject();
+    return { ...net, places: net.places.map((p) => (p.id === id ? { ...p, label } : p)) };
+  }
+  if (net.transitions.some((t) => t.id !== id && t.label === label)) throw reject();
+  return { ...net, transitions: net.transitions.map((t) => (t.id === id ? { ...t, label } : t)) };
+}
+
+function checkTokens(v: number): void {
+  if (!Number.isInteger(v) || v < 0 || v > MAX) {
+    throw new ValidationError("Tokens must be a non-negative integer.");
+  }
+}
+
+export function setInitialTokens(net: Net, placeId: NodeId, v: number): Net {
+  checkTokens(v);
+  return { ...net, places: net.places.map((p) => (p.id === placeId ? { ...p, initialTokens: v } : p)) };
+}
+
+export function setCurrentTokens(net: Net, placeId: NodeId, v: number): Net {
+  checkTokens(v);
+  return { ...net, places: net.places.map((p) => (p.id === placeId ? { ...p, currentTokens: v } : p)) };
+}
+
+export function setWeight(net: Net, arcId: string, v: number): Net {
+  if (!Number.isInteger(v) || v < 1 || v > MAX) {
+    throw new ValidationError("Arc weight must be a positive integer.");
+  }
+  return { ...net, arcs: net.arcs.map((a) => (a.id === arcId ? { ...a, weight: v } : a)) };
+}
+
+export function moveNode(net: Net, id: NodeId, x: number, y: number): Net {
+  return {
+    ...net,
+    places: net.places.map((p) => (p.id === id ? { ...p, x, y } : p)),
+    transitions: net.transitions.map((t) => (t.id === id ? { ...t, x, y } : t)),
+  };
+}
+
+export function serializeNet(net: Net): string {
+  const clean: Net = {
+    schemaVersion: 1,
+    places: net.places.map((p) => ({
+      id: p.id,
+      label: p.label,
+      x: p.x,
+      y: p.y,
+      initialTokens: p.initialTokens,
+      currentTokens: p.currentTokens,
+    })),
+    transitions: net.transitions.map((t) => ({ id: t.id, label: t.label, x: t.x, y: t.y })),
+    arcs: net.arcs.map((a) => ({
+      id: a.id,
+      sourceId: a.sourceId,
+      targetId: a.targetId,
+      weight: a.weight,
+    })),
+  };
+  return JSON.stringify(clean, null, 2);
+}
+
+export function parseNet(text: string): Net {
+  let value: unknown;
+  try {
+    value = JSON.parse(text);
+  } catch {
+    throw new ValidationError("file is not valid JSON.");
+  }
+  return validateNet(value);
+}
+
+function checkRecordKeys(obj: Record<string, unknown>, keys: string[], what: string): void {
+  for (const k of keys) {
+    if (!(k in obj)) throw new ValidationError(`${what} is missing key "${k}".`);
+  }
+  for (const k of Object.keys(obj)) {
+    if (!keys.includes(k)) throw new ValidationError(`${what} has unexpected key "${k}".`);
+  }
+}
+
+function isRecord(v: unknown): v is Record<string, unknown> {
+  return typeof v === "object" && v !== null && !Array.isArray(v);
+}
+
+function checkFiniteNumber(v: unknown): v is number {
+  return typeof v === "number" && Number.isFinite(v);
+}
+
+/** All-or-nothing deep validation; throws ValidationError with the first concrete reason. */
+export function validateNet(value: unknown): Net {
+  if (!isRecord(value)) throw new ValidationError("net must be a JSON object.");
+  if (value.schemaVersion !== 1) throw new ValidationError("schemaVersion must be 1.");
+  const top = ["schemaVersion", "places", "transitions", "arcs"];
+  for (const k of Object.keys(value)) {
+    if (!top.includes(k)) throw new ValidationError(`unexpected top-level key "${k}".`);
+  }
+  for (const k of top) {
+    if (!(k in value)) throw new ValidationError(`missing top-level key "${k}".`);
+  }
+  if (!Array.isArray(value.places)) throw new ValidationError("places must be an array.");
+  if (!Array.isArray(value.transitions)) throw new ValidationError("transitions must be an array.");
+  if (!Array.isArray(value.arcs)) throw new ValidationError("arcs must be an array.");
+
+  const ids = new Set<string>();
+  const takeId = (id: unknown, what: string): string => {
+    if (typeof id !== "string" || id === "") {
+      throw new ValidationError(`${what} id must be a non-empty string.`);
+    }
+    if (ids.has(id)) throw new ValidationError(`duplicate id "${id}".`);
+    ids.add(id);
+    return id;
+  };
+
+  const places: Place[] = [];
+  const placeLabels = new Set<string>();
+  for (const raw of value.places) {
+    if (!isRecord(raw)) throw new ValidationError("place must be an object.");
+    checkRecordKeys(raw, ["id", "label", "x", "y", "initialTokens", "currentTokens"], "place");
+    const id = takeId(raw.id, "place");
+    if (typeof raw.label !== "string" || raw.label.trim() === "") {
+      throw new ValidationError(`place "${id}" label must be a non-empty string.`);
+    }
+    if (placeLabels.has(raw.label)) throw new ValidationError(`place label "${raw.label}" is not unique.`);
+    placeLabels.add(raw.label);
+    if (!checkFiniteNumber(raw.x) || !checkFiniteNumber(raw.y)) {
+      throw new ValidationError(`place "${id}" has invalid coordinates.`);
+    }
+    if (!Number.isInteger(raw.initialTokens) || (raw.initialTokens as number) < 0 || (raw.initialTokens as number) > MAX) {
+      throw new ValidationError(`place "${id}" initialTokens must be a non-negative integer.`);
+    }
+    if (!Number.isInteger(raw.currentTokens) || (raw.currentTokens as number) < 0 || (raw.currentTokens as number) > MAX) {
+      throw new ValidationError(`place "${id}" currentTokens must be a non-negative integer.`);
+    }
+    places.push({
+      id,
+      label: raw.label,
+      x: raw.x,
+      y: raw.y,
+      initialTokens: raw.initialTokens as number,
+      currentTokens: raw.currentTokens as number,
+    });
+  }
+
+  const transitions: Transition[] = [];
+  const transitionLabels = new Set<string>();
+  for (const raw of value.transitions) {
+    if (!isRecord(raw)) throw new ValidationError("transition must be an object.");
+    checkRecordKeys(raw, ["id", "label", "x", "y"], "transition");
+    const id = takeId(raw.id, "transition");
+    if (typeof raw.label !== "string" || raw.label.trim() === "") {
+      throw new ValidationError(`transition "${id}" label must be a non-empty string.`);
+    }
+    if (transitionLabels.has(raw.label)) {
+      throw new ValidationError(`transition label "${raw.label}" is not unique.`);
+    }
+    transitionLabels.add(raw.label);
+    if (!checkFiniteNumber(raw.x) || !checkFiniteNumber(raw.y)) {
+      throw new ValidationError(`transition "${id}" has invalid coordinates.`);
+    }
+    transitions.push({ id, label: raw.label, x: raw.x, y: raw.y });
+  }
+
+  const kindOf = (nid: string): "place" | "transition" | null =>
+    places.some((p) => p.id === nid)
+      ? "place"
+      : transitions.some((t) => t.id === nid)
+        ? "transition"
+        : null;
+
+  const arcs: Arc[] = [];
+  const pairs = new Set<string>();
+  for (const raw of value.arcs) {
+    if (!isRecord(raw)) throw new ValidationError("arc must be an object.");
+    checkRecordKeys(raw, ["id", "sourceId", "targetId", "weight"], "arc");
+    const id = takeId(raw.id, "arc");
+    if (typeof raw.sourceId !== "string" || typeof raw.targetId !== "string") {
+      throw new ValidationError(`arc "${id}" has invalid endpoints.`);
+    }
+    const sk = kindOf(raw.sourceId);
+    if (sk === null) throw new ValidationError(`arc "${id}" references unknown node "${raw.sourceId}".`);
+    const tk = kindOf(raw.targetId);
+    if (tk === null) throw new ValidationError(`arc "${id}" references unknown node "${raw.targetId}".`);
+    if (sk === tk) {
+      const what = sk === "place" ? "two places" : "two transitions";
+      throw new ValidationError(`arc "${id}" connects ${what}; arcs must connect a place to a transition.`);
+    }
+    if (!Number.isInteger(raw.weight) || (raw.weight as number) < 1 || (raw.weight as number) > MAX) {
+      throw new ValidationError("arc weight must be a positive integer.");
+    }
+    const key = `${raw.sourceId}␀${raw.targetId}`;
+    if (pairs.has(key)) {
+      throw new ValidationError(
+        `arc "${id}" duplicates an existing arc from "${raw.sourceId}" to "${raw.targetId}".`,
+      );
+    }
+    pairs.add(key);
+    arcs.push({ id, sourceId: raw.sourceId, targetId: raw.targetId, weight: raw.weight as number });
+  }
+
+  return { schemaVersion: 1, places, transitions, arcs };
+}
diff --git a/src/store.ts b/src/store.ts
new file mode 100644
index 0000000..534eaaa
--- /dev/null
+++ b/src/store.ts
@@ -0,0 +1,400 @@
+import type { NodeId, Selection } from "./types";
+import {
+  addArc,
+  addPlace,
+  addTransition,
+  deleteArc,
+  deleteNode,
+  emptyNet,
+  fire,
+  isEnabled,
+  labelOf,
+  moveNode,
+  nodeKind,
+  parseNet,
+  resetMarking,
+  serializeNet,
+  setCurrentTokens,
+  setInitialTokens,
+  setLabel,
+  setWeight,
+  ValidationError,
+} from "./model";
+import type { Net } from "./types";
+
+export const STORAGE_KEY = "petri-net-editor:v1";
+
+export interface EditorState {
+  net: Net;
+  selection: Selection;
+  drawMode: boolean;
+  pendingSource: NodeId | null;
+  status: string;
+  alert: string;
+  feedbackSeq: number;
+}
+
+type Listener = () => void;
+
+function parseFieldNumber(raw: string): number {
+  const trimmed = raw.trim();
+  if (trimmed === "") return NaN;
+  return Number(trimmed);
+}
+
+export class EditorStore {
+  private state: EditorState;
+  private listeners = new Set<Listener>();
+  private storage: Storage;
+
+  constructor(storage: Storage = globalThis.localStorage) {
+    this.storage = storage;
+    let net = emptyNet();
+    let alert = "";
+    const raw = this.storage.getItem(STORAGE_KEY);
+    if (raw !== null) {
+      try {
+        net = parseNet(raw);
+      } catch {
+        net = emptyNet();
+        alert = "Saved net could not be loaded; starting with a new net.";
+      }
+    }
+    this.state = {
+      net,
+      selection: null,
+      drawMode: false,
+      pendingSource: null,
+      status: "",
+      alert,
+      feedbackSeq: alert ? 1 : 0,
+    };
+  }
+
+  getState(): Readonly<EditorState> {
+    return this.state;
+  }
+
+  subscribe(fn: Listener): () => void {
+    this.listeners.add(fn);
+    return () => this.listeners.delete(fn);
+  }
+
+  private notify(): void {
+    for (const fn of this.listeners) fn();
+  }
+
+  private persist(): void {
+    this.storage.setItem(STORAGE_KEY, serializeNet(this.state.net));
+  }
+
+  private setStatus(message: string): void {
+    this.state.status = message;
+    this.state.feedbackSeq += 1;
+  }
+
+  private setAlert(message: string): void {
+    this.state.alert = message;
+    this.state.feedbackSeq += 1;
+  }
+
+  private exitDrawSilently(): void {
+    this.state.drawMode = false;
+    this.state.pendingSource = null;
+  }
+
+  // -- selection ----------------------------------------------------------
+
+  select(selection: Selection): void {
+    this.state.selection = selection;
+    this.notify();
+  }
+
+  clearSelection(): void {
+    this.state.selection = null;
+    this.notify();
+  }
+
+  // -- node / arc creation ------------------------------------------------
+
+  addPlace(x: number, y: number): NodeId {
+    this.exitDrawSilently();
+    const r = addPlace(this.state.net, x, y);
+    this.state.net = r.net;
+    this.state.selection = { kind: "place", id: r.id };
+    this.persist();
+    this.notify();
+    return r.id;
+  }
+
+  addTransition(x: number, y: number): NodeId {
+    this.exitDrawSilently();
+    const r = addTransition(this.state.net, x, y);
+    this.state.net = r.net;
+    this.state.selection = { kind: "transition", id: r.id };
+    this.persist();
+    this.notify();
+    return r.id;
+  }
+
+  // -- draw-arc gesture ---------------------------------------------------
+
+  startDrawArc(): void {
+    this.state.drawMode = true;
+    this.state.pendingSource = null;
+    this.setStatus("Draw arc: click source, then click target.");
+    this.notify();
+  }
+
+  cancelDrawArc(): void {
+    if (!this.state.drawMode) return;
+    this.exitDrawSilently();
+    this.setStatus("Arc drawing cancelled.");
+    this.notify();
+  }
+
+  /** A place/transition was activated on the canvas. */
+  handleNodeActivate(id: NodeId): void {
+    if (this.state.drawMode) {
+      this.gestureNodeClick(id);
+      return;
+    }
+    const kind = nodeKind(this.state.net, id);
+    if (kind === null) return;
+    this.state.selection = { kind, id };
+    this.notify();
+  }
+
+  /** An arc was activated on the canvas. */
+  handleArcActivate(id: string): void {
+    if (this.state.drawMode) return; // arcs play no role in the gesture
+    if (!this.state.net.arcs.some((a) => a.id === id)) return;
+    this.state.selection = { kind: "arc", id };
+    this.notify();
+  }
+
+  handleCanvasBackgroundClick(): void {
+    if (this.state.drawMode) {
+      this.exitDrawSilently();
+      this.setStatus("Arc drawing cancelled.");
+      this.notify();
+      return;
+    }
+    this.clearSelection();
+  }
+
+  private gestureNodeClick(id: NodeId): void {
+    if (this.state.pendingSource === null) {
+      this.state.pendingSource = id;
+      this.setStatus(`Draw arc: source ${labelOf(this.state.net, id)} selected, click target.`);
+      this.notify();
+      return;
+    }
+    this.completeArc(this.state.pendingSource, id);
+  }
+
+  /** Finish an arc from source to target while in draw mode (two-click or drag). */
+  completeArc(source: NodeId, target: NodeId): void {
+    if (!this.state.drawMode) return;
+    const net = this.state.net;
+    const sk = nodeKind(net, source);
+    const tk = nodeKind(net, target);
+    if (sk === null || tk === null) return;
+    if (source === target || sk === tk) {
+      this.setAlert("Arcs must connect a place to a transition.");
+      this.notify();
+      return;
+    }
+    try {
+      const nextNet = addArc(net, source, target);
+      const arc = nextNet.arcs[nextNet.arcs.length - 1];
+      this.state.net = nextNet;
+      this.exitDrawSilently();
+      this.state.selection = { kind: "arc", id: arc.id };
+      this.persist();
+      this.setStatus(`Arc ${labelOf(net, source)} to ${labelOf(net, target)} created.`);
+    } catch (e) {
+      this.setAlert(errorMessage(e));
+    }
+    this.notify();
+  }
+
+  // -- fire / delete / reset / new ---------------------------------------
+
+  fireSelected(): void {
+    this.exitDrawSilently();
+    const sel = this.state.selection;
+    if (sel === null) {
+      this.setAlert("Nothing selected.");
+      this.notify();
+      return;
+    }
+    if (sel.kind !== "transition") {
+      this.setAlert("Select a transition to fire.");
+      this.notify();
+      return;
+    }
+    const label = labelOf(this.state.net, sel.id);
+    if (!isEnabled(this.state.net, sel.id)) {
+      this.setAlert(`Transition ${label} is not enabled.`);
+      this.notify();
+      return;
+    }
+    this.state.net = fire(this.state.net, sel.id);
+    this.persist();
+    this.setStatus(`Fired ${label}.`);
+    this.notify();
+  }
+
+  deleteSelection(): void {
+    this.exitDrawSilently();
+    const sel = this.state.selection;
+    if (sel === null) {
+      this.setAlert("Nothing selected.");
+      this.notify();
+      return;
+    }
+    if (sel.kind === "arc") {
+      const { net, arc } = deleteArc(this.state.net, sel.id);
+      if (arc) {
+        const src = labelOf(this.state.net, arc.sourceId);
+        const tgt = labelOf(this.state.net, arc.targetId);
+        this.state.net = net;
+        this.state.selection = null;
+        this.persist();
+        this.setStatus(`Deleted arc ${src} to ${tgt}.`);
+      }
+      this.notify();
+      return;
+    }
+    const label = labelOf(this.state.net, sel.id);
+    const { net, removedArcs } = deleteNode(this.state.net, sel.id);
+    this.state.net = net;
+    this.state.selection = null;
+    this.persist();
+    if (removedArcs > 0) {
+      this.setStatus(`Deleted ${label} and ${removedArcs} connected arc(s).`);
+    } else {
+      this.setStatus(`Deleted ${label}.`);
+    }
+    this.notify();
+  }
+
+  resetMarking(): void {
+    this.exitDrawSilently();
+    this.state.net = resetMarking(this.state.net);
+    this.persist();
+    this.setStatus("Marking reset.");
+    this.notify();
+  }
+
+  newNet(): void {
+    this.exitDrawSilently();
+    this.state.net = emptyNet();
+    this.state.selection = null;
+    this.persist();
+    this.setStatus("New net created.");
+    this.notify();
+  }
+
+  // -- inspector edits ----------------------------------------------------
+
+  editLabel(id: NodeId, raw: string): boolean {
+    try {
+      this.state.net = setLabel(this.state.net, id, raw);
+      this.persist();
+      this.notify();
+      return true;
+    } catch (e) {
+      this.setAlert(errorMessage(e));
+      this.notify();
+      return false;
+    }
+  }
+
+  editInitialTokens(placeId: NodeId, raw: string): boolean {
+    return this.editNumberField(() =>
+      setInitialTokens(this.state.net, placeId, parseFieldNumber(raw)),
+    );
+  }
+
+  editCurrentTokens(placeId: NodeId, raw: string): boolean {
+    return this.editNumberField(() =>
+      setCurrentTokens(this.state.net, placeId, parseFieldNumber(raw)),
+    );
+  }
+
+  editWeight(arcId: string, raw: string): boolean {
+    return this.editNumberField(() => setWeight(this.state.net, arcId, parseFieldNumber(raw)));
+  }
+
+  private editNumberField(apply: () => Net): boolean {
+    try {
+      this.state.net = apply();
+      this.persist();
+      this.notify();
+      return true;
+    } catch (e) {
+      this.setAlert(errorMessage(e));
+      this.notify();
+      return false;
+    }
+  }
+
+  moveNode(id: NodeId, x: number, y: number): void {
+    this.state.net = moveNode(this.state.net, id, x, y);
+    this.persist();
+    this.notify();
+  }
+
+  // -- export / import ----------------------------------------------------
+
+  serialized(): string {
+    return serializeNet(this.state.net);
+  }
+
+  exportFilename(date: Date = new Date()): string {
+    const pad = (n: number) => String(n).padStart(2, "0");
+    const y = date.getFullYear();
+    const mo = pad(date.getMonth() + 1);
+    const d = pad(date.getDate());
+    const hh = pad(date.getHours());
+    const mm = pad(date.getMinutes());
+    const ss = pad(date.getSeconds());
+    return `petri-net-${y}-${mo}-${d}-${hh}${mm}${ss}.json`;
+  }
+
+  exportNet(date: Date = new Date()): { filename: string; text: string } {
+    const net = this.state.net;
+    this.setStatus(
+      `Exported net (${net.places.length} places, ${net.transitions.length} transitions, ${net.arcs.length} arcs).`,
+    );
+    this.notify();
+    return { filename: this.exportFilename(date), text: serializeNet(net) };
+  }
+
+  importText(text: string): void {
+    this.exitDrawSilently();
+    let net: Net;
+    try {
+      net = parseNet(text);
+    } catch (e) {
+      this.setAlert(`Import failed: ${errorMessage(e)}`);
+      this.notify();
+      return;
+    }
+    this.state.net = net;
+    this.state.selection = null;
+    this.persist();
+    this.setStatus(
+      `Imported net (${net.places.length} places, ${net.transitions.length} transitions, ${net.arcs.length} arcs).`,
+    );
+    this.notify();
+  }
+}
+
+function errorMessage(e: unknown): string {
+  if (e instanceof ValidationError) return e.message;
+  if (e instanceof Error) return e.message;
+  return String(e);
+}
diff --git a/src/types.ts b/src/types.ts
new file mode 100644
index 0000000..541a526
--- /dev/null
+++ b/src/types.ts
@@ -0,0 +1,38 @@
+export type NodeId = string;
+export type ArcId = string;
+
+export interface Place {
+  id: NodeId;
+  label: string;
+  x: number;
+  y: number;
+  initialTokens: number;
+  currentTokens: number;
+}
+
+export interface Transition {
+  id: NodeId;
+  label: string;
+  x: number;
+  y: number;
+}
+
+export interface Arc {
+  id: ArcId;
+  sourceId: NodeId;
+  targetId: NodeId;
+  weight: number;
+}
+
+export interface Net {
+  schemaVersion: 1;
+  places: Place[];
+  transitions: Transition[];
+  arcs: Arc[];
+}
+
+export type Selection =
+  | { kind: "place"; id: NodeId }
+  | { kind: "transition"; id: NodeId }
+  | { kind: "arc"; id: ArcId }
+  | null;
diff --git a/src/ui.ts b/src/ui.ts
new file mode 100644
index 0000000..f8c90fb
--- /dev/null
+++ b/src/ui.ts
@@ -0,0 +1,564 @@
+import type { EditorStore, EditorState } from "./store";
+import { isEnabled } from "./model";
+import type { Arc, NodeId } from "./types";
+
+const SVGNS = "http://www.w3.org/2000/svg";
+const PLACE_R = 22;
+const TRANS_SIZE = 44;
+const TRANS_HALF = TRANS_SIZE / 2;
+const PAD = 30;
+
+function el<K extends keyof HTMLElementTagNameMap>(tag: K): HTMLElementTagNameMap[K] {
+  return document.createElement(tag);
+}
+function svgEl(tag: string): SVGElement {
+  return document.createElementNS(SVGNS, tag) as SVGElement;
+}
+function clamp(v: number, lo: number, hi: number): number {
+  return Math.max(lo, Math.min(hi, v));
+}
+
+const STYLE = `
+.app{font-family:system-ui,-apple-system,Segoe UI,Roboto,sans-serif;color:#12203a;display:flex;flex-direction:column;height:100vh;box-sizing:border-box;}
+.toolbar{display:flex;flex-wrap:wrap;gap:6px;padding:10px;border-bottom:1px solid #d7deeb;background:#f6f8fc;}
+.btn{font:inherit;padding:6px 12px;border:1px solid #9fb0cc;border-radius:6px;background:#fff;cursor:pointer;color:#12203a;}
+.btn:hover{background:#eef3fb;}
+.btn:focus-visible{outline:2px solid #2f6df6;outline-offset:1px;}
+.btn[aria-pressed="true"]{background:#2f6df6;color:#fff;border-color:#2f6df6;}
+.btn[aria-disabled="true"]{opacity:.5;}
+.workspace{display:flex;flex:1;min-height:0;}
+.canvas-region{flex:1;position:relative;overflow:hidden;background:#fff;}
+.canvas-region svg{width:100%;height:100%;display:block;touch-action:none;}
+.inspector{width:260px;border-left:1px solid #d7deeb;padding:12px;box-sizing:border-box;background:#fbfcfe;overflow:auto;}
+.inspector h2{font-size:14px;margin:0 0 10px;}
+.field{display:flex;flex-direction:column;gap:2px;margin-bottom:10px;font-size:13px;}
+.field input{font:inherit;padding:4px 6px;border:1px solid #9fb0cc;border-radius:4px;}
+.summary{font-size:13px;margin:4px 0;color:#3a4a66;}
+.hint{font-size:13px;color:#3a4a66;}
+.node{cursor:pointer;}
+.node text{font-size:12px;fill:#12203a;pointer-events:none;user-select:none;}
+.node .body{fill:#eaf1ff;stroke:#3763b8;stroke-width:2;}
+.node.transition .body{fill:#e8eefc;}
+.node.selected .body{stroke:#f6851f;stroke-width:3.5;}
+.node:focus-visible .body{stroke:#2f6df6;stroke-width:3.5;}
+.node.pending .body{stroke:#12b76a;stroke-width:3.5;}
+.arc .line{stroke:#4a5b7a;stroke-width:2;}
+.arc .hit{stroke:transparent;stroke-width:14;fill:none;cursor:pointer;}
+.arc.selected .line{stroke:#f6851f;stroke-width:3.5;}
+.arc:focus-visible .line{stroke:#2f6df6;stroke-width:3.5;}
+.arc text{font-size:12px;fill:#12203a;pointer-events:none;user-select:none;}
+.feedback{padding:6px 10px;border-top:1px solid #d7deeb;min-height:1.4em;font-size:13px;background:#f6f8fc;}
+.feedback .alert-line{color:#b42318;font-weight:600;}
+.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;border:0;}
+`;
+
+const CONTROLS: Array<{ name: string; action: (ctx: UIContext) => void }> = [
+  { name: "Add place", action: (c) => c.store.addPlace(...c.nextPos()) },
+  { name: "Add transition", action: (c) => c.store.addTransition(...c.nextPos()) },
+  { name: "Draw arc", action: (c) => c.store.startDrawArc() },
+  { name: "Fire selected transition", action: (c) => c.store.fireSelected() },
+  { name: "Delete selection", action: (c) => c.store.deleteSelection() },
+  { name: "New net", action: (c) => c.store.newNet() },
+  { name: "Reset marking", action: (c) => c.store.resetMarking() },
+  { name: "Export JSON", action: (c) => c.doExport() },
+];
+
+interface UIContext {
+  store: EditorStore;
+  nextPos: () => [number, number];
+  doExport: () => void;
+}
+
+export function mountApp(root: HTMLElement, store: EditorStore): void {
+  document.title = "Petri net editor";
+  root.innerHTML = "";
+
+  const style = el("style");
+  style.textContent = STYLE;
+  root.appendChild(style);
+
+  const main = el("main");
+  main.className = "app";
+  main.setAttribute("role", "application");
+  main.setAttribute("aria-label", "Petri net editor");
+
+  // -- toolbar ------------------------------------------------------------
+  const toolbar = el("div");
+  toolbar.setAttribute("role", "toolbar");
+  toolbar.setAttribute("aria-label", "Editor controls");
+  toolbar.className = "toolbar";
+
+  const nextPos = (): [number, number] => {
+    const state = store.getState();
+    const n = state.net.places.length + state.net.transitions.length;
+    return [120 + (n % 6) * 120, 90 + Math.floor(n / 6) * 110];
+  };
+  const doExport = (): void => {
+    const { filename, text } = store.exportNet();
+    try {
+      const blob = new Blob([text], { type: "application/json" });
+      const url = URL.createObjectURL(blob);
+      const a = el("a");
+      a.href = url;
+      a.download = filename;
+      root.appendChild(a);
+      a.click();
+      a.remove();
+      URL.revokeObjectURL(url);
+    } catch {
+      /* environments without Blob URL support (e.g. tests) */
+    }
+  };
+  const ctx: UIContext = { store, nextPos, doExport };
+
+  const buttons = new Map<string, HTMLButtonElement>();
+  for (const control of CONTROLS) {
+    const b = el("button");
+    b.type = "button";
+    b.className = "btn";
+    b.textContent = control.name;
+    b.addEventListener("click", () => control.action(ctx));
+    buttons.set(control.name, b);
+    toolbar.appendChild(b);
+  }
+  const drawBtn = buttons.get("Draw arc")!;
+  drawBtn.setAttribute("aria-pressed", "false");
+  const fireBtn = buttons.get("Fire selected transition")!;
+  fireBtn.setAttribute("aria-disabled", "true");
+
+  // Import JSON: a label styled as a button, role button, wrapping a hidden file input.
+  const importLabel = el("label");
+  importLabel.className = "btn";
+  importLabel.setAttribute("role", "button");
+  importLabel.setAttribute("aria-label", "Import JSON");
+  importLabel.tabIndex = 0;
+  importLabel.appendChild(document.createTextNode("Import JSON"));
+  const fileInput = el("input");
+  fileInput.type = "file";
+  fileInput.accept = "application/json";
+  fileInput.className = "sr-only";
+  fileInput.addEventListener("change", () => {
+    const f = fileInput.files && fileInput.files[0];
+    if (!f) return;
+    f.text()
+      .then((text) => store.importText(text))
+      .catch(() => store.importText(""))
+      .finally(() => {
+        fileInput.value = "";
+      });
+  });
+  importLabel.addEventListener("keydown", (e) => {
+    if (e.key === "Enter" || e.key === " ") {
+      e.preventDefault();
+      fileInput.click();
+    }
+  });
+  importLabel.appendChild(fileInput);
+  toolbar.appendChild(importLabel);
+
+  // -- canvas -------------------------------------------------------------
+  const region = el("div");
+  region.setAttribute("role", "region");
+  region.setAttribute("aria-label", "Petri net canvas");
+  region.className = "canvas-region";
+
+  const svg = svgEl("svg");
+  svg.setAttribute("xmlns", SVGNS);
+  const defs = svgEl("defs");
+  const marker = svgEl("marker");
+  marker.setAttribute("id", "arc-arrow");
+  marker.setAttribute("viewBox", "0 0 10 10");
+  marker.setAttribute("refX", "9");
+  marker.setAttribute("refY", "5");
+  marker.setAttribute("markerWidth", "7");
+  marker.setAttribute("markerHeight", "7");
+  marker.setAttribute("orient", "auto-start-reverse");
+  const markerPath = svgEl("path");
+  markerPath.setAttribute("d", "M0,0 L10,5 L0,10 z");
+  markerPath.setAttribute("fill", "#4a5b7a");
+  marker.appendChild(markerPath);
+  defs.appendChild(marker);
+  svg.appendChild(defs);
+
+  const bgRect = svgEl("rect");
+  bgRect.setAttribute("data-bg", "");
+  bgRect.setAttribute("x", "0");
+  bgRect.setAttribute("y", "0");
+  bgRect.setAttribute("width", "100%");
+  bgRect.setAttribute("height", "100%");
+  bgRect.setAttribute("fill", "transparent");
+  bgRect.addEventListener("click", () => store.handleCanvasBackgroundClick());
+  svg.appendChild(bgRect);
+
+  const arcsLayer = svgEl("g");
+  arcsLayer.setAttribute("data-layer", "arcs");
+  const nodesLayer = svgEl("g");
+  nodesLayer.setAttribute("data-layer", "nodes");
+  svg.appendChild(arcsLayer);
+  svg.appendChild(nodesLayer);
+  region.appendChild(svg);
+
+  // -- inspector + feedback ----------------------------------------------
+  const aside = el("aside");
+  aside.setAttribute("aria-label", "Inspector");
+  aside.className = "inspector";
+
+  const workspace = el("div");
+  workspace.className = "workspace";
+  workspace.append(region, aside);
+
+  const feedback = el("div");
+  feedback.className = "feedback";
+  const statusEl = el("div");
+  statusEl.setAttribute("role", "status");
+  statusEl.setAttribute("aria-live", "polite");
+  const alertEl = el("div");
+  alertEl.setAttribute("role", "alert");
+  alertEl.className = "alert-line";
+  feedback.append(statusEl, alertEl);
+
+  main.append(toolbar, workspace, feedback);
+  root.appendChild(main);
+
+  // -- pointer gestures (real browser); tests use click paths ------------
+  let gestureSource: NodeId | null = null;
+  let gestureMoved = false;
+  let moving: NodeId | null = null;
+
+  const nodeIdFromEvent = (e: Event): NodeId | null => {
+    const t = e.target as Element | null;
+    const g = t && typeof t.closest === "function" ? t.closest("[data-node-id]") : null;
+    return g ? g.getAttribute("data-node-id") : null;
+  };
+  const onPointerMove = (e: PointerEvent): void => {
+    if (store.getState().drawMode) {
+      if (gestureSource) gestureMoved = true;
+      return;
+    }
+    if (moving) {
+      gestureMoved = true;
+      const rect = svg.getBoundingClientRect();
+      let x = e.clientX - rect.left;
+      let y = e.clientY - rect.top;
+      if (rect.width > 0 && rect.height > 0) {
+        x = clamp(x, PAD, rect.width - PAD);
+        y = clamp(y, PAD, rect.height - PAD);
+      }
+      const sel = store.getState().selection;
+      if (!sel || sel.id !== moving) store.handleNodeActivate(moving);
+      store.moveNode(moving, x, y);
+    }
+  };
+  const onPointerUp = (e: PointerEvent): void => {
+    window.removeEventListener("pointermove", onPointerMove);
+    window.removeEventListener("pointerup", onPointerUp);
+    if (store.getState().drawMode && gestureSource) {
+      const target = nodeIdFromEvent(e);
+      if (target && gestureMoved && target !== gestureSource) {
+        store.completeArc(gestureSource, target);
+      }
+    }
+    gestureSource = null;
+    moving = null;
+    gestureMoved = false;
+  };
+  const onNodePointerDown = (_e: PointerEvent, id: NodeId): void => {
+    if (store.getState().drawMode) {
+      gestureSource = id;
+    } else {
+      moving = id;
+    }
+    gestureMoved = false;
+    window.addEventListener("pointermove", onPointerMove);
+    window.addEventListener("pointerup", onPointerUp);
+  };
+
+  // -- keyboard on the application root -----------------------------------
+  main.addEventListener("keydown", (e) => {
+    const target = e.target as HTMLElement | null;
+    const inInput = !!target && target.tagName === "INPUT";
+    if (e.key === "Escape") {
+      if (inInput) return; // input handles its own revert
+      if (store.getState().drawMode) {
+        store.cancelDrawArc();
+        e.preventDefault();
+      }
+      return;
+    }
+    if ((e.key === "Delete" || e.key === "Backspace") && !inInput) {
+      store.deleteSelection();
+      e.preventDefault();
+    }
+  });
+
+  // -- rendering ----------------------------------------------------------
+  function nodeCenter(state: EditorState, id: NodeId): { x: number; y: number; kind: "place" | "transition" } | null {
+    const p = state.net.places.find((n) => n.id === id);
+    if (p) return { x: p.x, y: p.y, kind: "place" };
+    const t = state.net.transitions.find((n) => n.id === id);
+    if (t) return { x: t.x, y: t.y, kind: "transition" };
+    return null;
+  }
+
+  function renderCanvas(state: EditorState): void {
+    while (arcsLayer.firstChild) arcsLayer.removeChild(arcsLayer.firstChild);
+    while (nodesLayer.firstChild) nodesLayer.removeChild(nodesLayer.firstChild);
+    const sel = state.selection;
+
+    for (const arc of state.net.arcs) {
+      renderArc(state, arc, sel !== null && sel.kind === "arc" && sel.id === arc.id);
+    }
+    for (const p of state.net.places) {
+      const g = svgEl("g");
+      g.setAttribute("class", `node place${sel && sel.id === p.id ? " selected" : ""}${state.pendingSource === p.id ? " pending" : ""}`);
+      g.setAttribute("role", "button");
+      g.setAttribute("tabindex", "0");
+      g.setAttribute("aria-label", `Place: ${p.label}`);
+      g.setAttribute("data-node-id", p.id);
+      const circle = svgEl("circle");
+      circle.setAttribute("class", "body");
+      circle.setAttribute("cx", String(p.x));
+      circle.setAttribute("cy", String(p.y));
+      circle.setAttribute("r", String(PLACE_R));
+      const tokens = svgEl("text");
+      tokens.setAttribute("x", String(p.x));
+      tokens.setAttribute("y", String(p.y + 4));
+      tokens.setAttribute("text-anchor", "middle");
+      tokens.textContent = String(p.currentTokens);
+      const label = svgEl("text");
+      label.setAttribute("x", String(p.x));
+      label.setAttribute("y", String(p.y + PLACE_R + 14));
+      label.setAttribute("text-anchor", "middle");
+      label.textContent = p.label;
+      g.append(circle, tokens, label);
+      wireNode(g, p.id);
+      nodesLayer.appendChild(g);
+    }
+    for (const t of state.net.transitions) {
+      const enabled = isEnabled(state.net, t.id);
+      const g = svgEl("g");
+      g.setAttribute("class", `node transition${sel && sel.id === t.id ? " selected" : ""}${state.pendingSource === t.id ? " pending" : ""}`);
+      g.setAttribute("role", "button");
+      g.setAttribute("tabindex", "0");
+      g.setAttribute("aria-label", `Transition: ${t.label} (${enabled ? "enabled" : "disabled"})`);
+      g.setAttribute("data-node-id", t.id);
+      const rect = svgEl("rect");
+      rect.setAttribute("class", "body");
+      rect.setAttribute("x", String(t.x - TRANS_HALF));
+      rect.setAttribute("y", String(t.y - TRANS_HALF));
+      rect.setAttribute("width", String(TRANS_SIZE));
+      rect.setAttribute("height", String(TRANS_SIZE));
+      const label = svgEl("text");
+      label.setAttribute("x", String(t.x));
+      label.setAttribute("y", String(t.y + TRANS_HALF + 14));
+      label.setAttribute("text-anchor", "middle");
+      label.textContent = t.label;
+      g.append(rect, label);
+      wireNode(g, t.id);
+      nodesLayer.appendChild(g);
+    }
+  }
+
+  function renderArc(state: EditorState, arc: Arc, selected: boolean): void {
+    const s = nodeCenter(state, arc.sourceId);
+    const t = nodeCenter(state, arc.targetId);
+    if (!s || !t) return;
+    let x1 = s.x;
+    let y1 = s.y;
+    let x2 = t.x;
+    let y2 = t.y;
+    const dx = t.x - s.x;
+    const dy = t.y - s.y;
+    const len = Math.hypot(dx, dy);
+    if (len > 0) {
+      const ux = dx / len;
+      const uy = dy / len;
+      const so = s.kind === "place" ? PLACE_R : TRANS_HALF;
+      const to = t.kind === "place" ? PLACE_R : TRANS_HALF;
+      x1 = s.x + ux * so;
+      y1 = s.y + uy * so;
+      x2 = t.x - ux * (to + 4);
+      y2 = t.y - uy * (to + 4);
+    }
+    const g = svgEl("g");
+    g.setAttribute("class", `arc${selected ? " selected" : ""}`);
+    g.setAttribute("role", "button");
+    g.setAttribute("tabindex", "0");
+    const srcLabel = labelOfNode(state, arc.sourceId);
+    const tgtLabel = labelOfNode(state, arc.targetId);
+    g.setAttribute("aria-label", `Arc: ${srcLabel} to ${tgtLabel}`);
+    g.setAttribute("data-arc-id", arc.id);
+    const hit = svgEl("line");
+    hit.setAttribute("class", "hit");
+    hit.setAttribute("x1", String(x1));
+    hit.setAttribute("y1", String(y1));
+    hit.setAttribute("x2", String(x2));
+    hit.setAttribute("y2", String(y2));
+    const line = svgEl("line");
+    line.setAttribute("class", "line");
+    line.setAttribute("x1", String(x1));
+    line.setAttribute("y1", String(y1));
+    line.setAttribute("x2", String(x2));
+    line.setAttribute("y2", String(y2));
+    line.setAttribute("marker-end", "url(#arc-arrow)");
+    g.append(hit, line);
+    if (arc.weight > 1) {
+      const wt = svgEl("text");
+      wt.setAttribute("x", String((x1 + x2) / 2 + 6));
+      wt.setAttribute("y", String((y1 + y2) / 2 - 6));
+      wt.textContent = String(arc.weight);
+      g.appendChild(wt);
+    }
+    wireArc(g, arc.id);
+    arcsLayer.appendChild(g);
+  }
+
+  function labelOfNode(state: EditorState, id: NodeId): string {
+    const p = state.net.places.find((n) => n.id === id);
+    if (p) return p.label;
+    const t = state.net.transitions.find((n) => n.id === id);
+    return t ? t.label : id;
+  }
+
+  function wireNode(g: SVGElement, id: NodeId): void {
+    g.addEventListener("click", (e) => {
+      e.stopPropagation();
+      store.handleNodeActivate(id);
+    });
+    g.addEventListener("keydown", (e) => {
+      if (e.key === "Enter" || e.key === " ") {
+        e.preventDefault();
+        store.handleNodeActivate(id);
+      }
+    });
+    g.addEventListener("pointerdown", (e) => onNodePointerDown(e as PointerEvent, id));
+  }
+
+  function wireArc(g: SVGElement, id: string): void {
+    g.addEventListener("click", (e) => {
+      e.stopPropagation();
+      store.handleArcActivate(id);
+    });
+    g.addEventListener("keydown", (e) => {
+      if (e.key === "Enter" || e.key === " ") {
+        e.preventDefault();
+        store.handleArcActivate(id);
+      }
+    });
+  }
+
+  function field(
+    labelText: string,
+    type: "text" | "number",
+    value: string,
+    onCommit: (raw: string) => boolean,
+  ): HTMLLabelElement {
+    const wrapper = el("label");
+    wrapper.className = "field";
+    const span = el("span");
+    span.textContent = labelText;
+    const input = el("input");
+    input.type = type;
+    input.value = value;
+    wrapper.append(span, input);
+    let committed = value;
+    const commit = (): void => {
+      if (input.value === committed) return;
+      if (onCommit(input.value)) {
+        committed = input.value;
+      } else {
+        input.value = committed;
+      }
+    };
+    input.addEventListener("change", commit);
+    input.addEventListener("blur", commit);
+    input.addEventListener("keydown", (e) => {
+      if (e.key === "Enter") {
+        e.preventDefault();
+        commit();
+      } else if (e.key === "Escape") {
+        e.preventDefault();
+        e.stopPropagation();
+        input.value = committed;
+      }
+    });
+    return wrapper;
+  }
+
+  function summary(text: string): HTMLElement {
+    const p = el("p");
+    p.className = "summary";
+    p.textContent = text;
+    return p;
+  }
+
+  function renderInspector(state: EditorState): void {
+    aside.innerHTML = "";
+    const heading = el("h2");
+    heading.textContent = "Inspector";
+    aside.appendChild(heading);
+    const sel = state.selection;
+    if (!sel) {
+      const hint = el("p");
+      hint.className = "hint";
+      hint.textContent = "Select a place, transition, or arc to edit its properties.";
+      aside.appendChild(hint);
+      return;
+    }
+    if (sel.kind === "place") {
+      const p = state.net.places.find((n) => n.id === sel.id);
+      if (!p) return;
+      aside.appendChild(field("Label", "text", p.label, (raw) => store.editLabel(p.id, raw)));
+      aside.appendChild(
+        field("Initial tokens", "number", String(p.initialTokens), (raw) =>
+          store.editInitialTokens(p.id, raw),
+        ),
+      );
+      aside.appendChild(
+        field("Current tokens", "number", String(p.currentTokens), (raw) =>
+          store.editCurrentTokens(p.id, raw),
+        ),
+      );
+      const incoming = state.net.arcs.filter((a) => a.targetId === p.id).length;
+      const outgoing = state.net.arcs.filter((a) => a.sourceId === p.id).length;
+      aside.appendChild(summary(`Incoming arcs: ${incoming}`));
+      aside.appendChild(summary(`Outgoing arcs: ${outgoing}`));
+      return;
+    }
+    if (sel.kind === "transition") {
+      const t = state.net.transitions.find((n) => n.id === sel.id);
+      if (!t) return;
+      aside.appendChild(field("Label", "text", t.label, (raw) => store.editLabel(t.id, raw)));
+      const incoming = state.net.arcs.filter((a) => a.targetId === t.id).length;
+      const outgoing = state.net.arcs.filter((a) => a.sourceId === t.id).length;
+      aside.appendChild(summary(`Enabled: ${isEnabled(state.net, t.id) ? "yes" : "no"}`));
+      aside.appendChild(summary(`Incoming arcs: ${incoming}`));
+      aside.appendChild(summary(`Outgoing arcs: ${outgoing}`));
+      return;
+    }
+    const arc = state.net.arcs.find((a) => a.id === sel.id);
+    if (!arc) return;
+    aside.appendChild(
+      field("Arc weight", "number", String(arc.weight), (raw) => store.editWeight(arc.id, raw)),
+    );
+    aside.appendChild(summary(`Source: ${labelOfNode(state, arc.sourceId)}`));
+    aside.appendChild(summary(`Target: ${labelOfNode(state, arc.targetId)}`));
+  }
+
+  function render(): void {
+    const state = store.getState();
+    drawBtn.setAttribute("aria-pressed", state.drawMode ? "true" : "false");
+    const fireable =
+      !!state.selection &&
+      state.selection.kind === "transition" &&
+      isEnabled(state.net, state.selection.id);
+    fireBtn.setAttribute("aria-disabled", fireable ? "false" : "true");
+    renderCanvas(state);
+    renderInspector(state);
+    statusEl.textContent = state.status;
+    alertEl.textContent = state.alert;
+  }
+
+  store.subscribe(render);
+  render();
+}
