+import { describe, it, expect, beforeEach } from "vitest";
+import { EditorStore, STORAGE_KEY } from "../src/store";
+import { parseNet } from "../src/model";
+
+beforeEach(() => {
+  localStorage.clear();
+});
+
+function fresh() {
+  return new EditorStore();
+}
+
+describe("§7.1 localStorage load", () => {
+  it("starts empty when no key present", () => {
+    const s = fresh();
+    const net = s.getState().net;
+    expect(net.places.length).toBe(0);
+    expect(net.transitions.length).toBe(0);
+    expect(net.arcs.length).toBe(0);
+  });
+
+  it("hydrates from a valid stored net", () => {
+    const s1 = fresh();
+    s1.addPlace(10, 20);
+    const s2 = fresh();
+    expect(s2.getState().net.places.length).toBe(1);
+  });
+
+  it("corrupt localStorage (garbage) starts empty and emits load-failure alert", () => {
+    localStorage.setItem(STORAGE_KEY, "!!! not json");
+    const s = fresh();
+    expect(s.getState().net.places.length).toBe(0);
+    expect(s.getState().alert).toBe(
+      "Saved net could not be loaded; starting with a new net.",
+    );
+  });
+
+  it("corrupt localStorage (wrong schemaVersion) starts empty and alerts", () => {
+    localStorage.setItem(
+      STORAGE_KEY,
+      JSON.stringify({ schemaVersion: 2, places: [], transitions: [], arcs: [] }),
+    );
+    const s = fresh();
+    expect(s.getState().net.places.length).toBe(0);
+    expect(s.getState().alert).toContain("Saved net could not be loaded");
+  });
+});
+
+describe("§7 persistence on mutations", () => {
+  it("every mutation ends with localStorage equal to in-memory net", () => {
+    const s = fresh();
+    const check = () => {
+      const stored = parseNet(localStorage.getItem(STORAGE_KEY)!);
+      expect(stored).toEqual(s.getState().net);
+    };
+    const p = s.addPlace(40, 40);
+    check();
+    const t = s.addTransition(120, 40);
+    check();
+    s.select({ kind: "place", id: p });
+    s.editInitialTokens(p, "2");
+    check();
+    s.editCurrentTokens(p, "2");
+    check();
+    s.handleNodeActivate(p); // select the place
+    s.moveNode(p, 55, 66);
+    check();
+    // draw an arc p -> t
+    s.startDrawArc();
+    s.handleNodeActivate(p);
+    s.handleNodeActivate(t);
+    check();
+    s.select({ kind: "transition", id: t });
+    s.fireSelected();
+    check();
+    s.resetMarking();
+    check();
+  });
+
+  it("does not persist on pure selection changes", () => {
+    const s = fresh();
+    s.addPlace(1, 2);
+    const before = localStorage.getItem(STORAGE_KEY);
+    s.select({ kind: "place", id: s.getState().net.places[0].id });
+    s.clearSelection();
+    expect(localStorage.getItem(STORAGE_KEY)).toBe(before);
+  });
+
+  it("New net overwrites localStorage with an empty net and reload stays empty", () => {
+    const s = fresh();
+    s.addPlace(1, 2);
+    s.newNet();
+    expect(s.getState().status).toBe("New net created.");
+    const reloaded = fresh();
+    expect(reloaded.getState().net.places.length).toBe(0);
+    expect(localStorage.getItem(STORAGE_KEY)).not.toBeNull();
+  });
+});
+
+describe("§7.2/§7.3 export + import", () => {
+  it("export -> import round trip reproduces the same net", () => {
+    const s = fresh();
+    const p = s.addPlace(120, 80);
+    const t = s.addTransition(260, 80);
+    s.startDrawArc();
+    s.handleNodeActivate(p);
+    s.handleNodeActivate(t);
+    const exported = s.exportNet();
+    const before = s.getState().net;
+    const s2 = fresh();
+    s2.importText(exported.text);
+    expect(s2.getState().net).toEqual(before);
+  });
+
+  it("export sets status and produces a dated filename", () => {
+    const s = fresh();
+    s.addPlace(1, 1);
+    const out = s.exportNet(new Date(2026, 6, 21, 9, 8, 7));
+    expect(out.filename).toBe("petri-net-2026-07-21-090807.json");
+    expect(s.getState().status).toBe(
+      "Exported net (1 places, 0 transitions, 0 arcs).",
+    );
+  });
+
+  it("import failure emits alert and leaves net unchanged", () => {
+    const s = fresh();
+    s.addPlace(1, 1);
+    const before = s.getState().net;
+    s.importText("garbage");
+    expect(s.getState().alert).toBe("Import failed: file is not valid JSON.");
+    expect(s.getState().net).toEqual(before);
+  });
+
+  it("import success replaces net, clears selection, sets status, persists", () => {
+    const s = fresh();
+    const good = JSON.stringify({
+      schemaVersion: 1,
+      places: [{ id: "p1", label: "P1", x: 0, y: 0, initialTokens: 1, currentTokens: 1 }],
+      transitions: [{ id: "t1", label: "T1", x: 0, y: 0 }],
+      arcs: [{ id: "a1", sourceId: "p1", targetId: "t1", weight: 1 }],
+    });
+    s.importText(good);
+    expect(s.getState().selection).toBeNull();
+    expect(s.getState().status).toBe("Imported net (1 places, 1 transitions, 1 arcs).");
+    expect(parseNet(localStorage.getItem(STORAGE_KEY)!)).toEqual(s.getState().net);
+  });
+});
+
+describe("§8.3 fire selected", () => {
+  it("nothing selected -> alert Nothing selected.", () => {
+    const s = fresh();
+    s.fireSelected();
+    expect(s.getState().alert).toBe("Nothing selected.");
+  });
+
+  it("place selected -> alert Select a transition to fire.", () => {
+    const s = fresh();
+    const p = s.addPlace(0, 0);
+    s.select({ kind: "place", id: p });
+    s.fireSelected();
+    expect(s.getState().alert).toBe("Select a transition to fire.");
+  });
+
+  it("disabled transition -> alert not enabled; no mutation", () => {
+    const s = fresh();
+    const p = s.addPlace(0, 0);
+    const t = s.addTransition(0, 0);
+    s.startDrawArc();
+    s.handleNodeActivate(p);
+    s.handleNodeActivate(t); // arc p->t weight 1, p has 0 tokens
+    s.select({ kind: "transition", id: t });
+    s.fireSelected();
+    expect(s.getState().alert).toBe(`Transition T1 is not enabled.`);
+  });
+
+  it("enabled transition -> status Fired <label>.", () => {
+    const s = fresh();
+    const t = s.addTransition(0, 0);
+    s.select({ kind: "transition", id: t });
+    s.fireSelected();
+    expect(s.getState().status).toBe("Fired T1.");
+  });
+});
+
+describe("§6 delete selection", () => {
+  it("nothing selected -> alert Nothing selected.", () => {
+    const s = fresh();
+    s.deleteSelection();
+    expect(s.getState().alert).toBe("Nothing selected.");
+  });
+
+  it("delete node with connected arcs cascades and reports count", () => {
+    const s = fresh();
+    const p = s.addPlace(0, 0);
+    const t = s.addTransition(0, 0);
+    s.startDrawArc();
+    s.handleNodeActivate(p);
+    s.handleNodeActivate(t);
+    s.select({ kind: "transition", id: t });
+    s.deleteSelection();
+    expect(s.getState().status).toBe("Deleted T1 and 1 connected arc(s).");
+    expect(s.getState().net.arcs.length).toBe(0);
+    expect(s.getState().selection).toBeNull();
+  });
+
+  it("delete node with no arcs drops the count clause", () => {
+    const s = fresh();
+    const p = s.addPlace(0, 0);
+    s.select({ kind: "place", id: p });
+    s.deleteSelection();
+    expect(s.getState().status).toBe("Deleted P1.");
+  });
+
+  it("delete arc reports source to target", () => {
+    const s = fresh();
+    const p = s.addPlace(0, 0);
+    const t = s.addTransition(0, 0);
+    s.startDrawArc();
+    s.handleNodeActivate(p);
+    s.handleNodeActivate(t);
+    const arcId = s.getState().net.arcs[0].id;
+    s.select({ kind: "arc", id: arcId });
+    s.deleteSelection();
+    expect(s.getState().status).toBe("Deleted arc P1 to T1.");
+  });
+});
+
+describe("§8.1 draw-arc gesture", () => {
+  it("full happy path creates one arc and selects it", () => {
+    const s = fresh();
+    const p = s.addPlace(0, 0);
+    const t = s.addTransition(0, 0);
+    s.startDrawArc();
+    expect(s.getState().status).toBe("Draw arc: click source, then click target.");
+    expect(s.getState().drawMode).toBe(true);
+    s.handleNodeActivate(p);
+    expect(s.getState().status).toBe("Draw arc: source P1 selected, click target.");
+    s.handleNodeActivate(t);
+    expect(s.getState().status).toBe("Arc P1 to T1 created.");
+    expect(s.getState().drawMode).toBe(false);
+    expect(s.getState().net.arcs.length).toBe(1);
+    expect(s.getState().selection).toEqual({ kind: "arc", id: s.getState().net.arcs[0].id });
+  });
+
+  it("same-kind second click is refused (V1) and stays in draw mode", () => {
+    const s = fresh();
+    const p1 = s.addPlace(0, 0);
+    const p2 = s.addPlace(0, 0);
+    s.startDrawArc();
+    s.handleNodeActivate(p1);
+    s.handleNodeActivate(p2);
+    expect(s.getState().alert).toBe("Arcs must connect a place to a transition.");
+    expect(s.getState().drawMode).toBe(true);
+    expect(s.getState().net.arcs.length).toBe(0);
+  });
+
+  it("duplicate arc second click is refused (V2) and stays in draw mode", () => {
+    const s = fresh();
+    const p = s.addPlace(0, 0);
+    const t = s.addTransition(0, 0);
+    s.startDrawArc();
+    s.handleNodeActivate(p);
+    s.handleNodeActivate(t); // created
+    s.startDrawArc();
+    s.handleNodeActivate(p);
+    s.handleNodeActivate(t); // duplicate
+    expect(s.getState().alert).toContain("already exists");
+    expect(s.getState().drawMode).toBe(true);
+    expect(s.getState().net.arcs.length).toBe(1);
+  });
+
+  it("escape cancels draw mode", () => {
+    const s = fresh();
+    s.startDrawArc();
+    s.cancelDrawArc();
+    expect(s.getState().status).toBe("Arc drawing cancelled.");
+    expect(s.getState().drawMode).toBe(false);
+  });
+
+  it("empty-canvas click cancels draw mode; otherwise clears selection", () => {
+    const s = fresh();
+    const p = s.addPlace(0, 0);
+    s.startDrawArc();
+    s.handleCanvasBackgroundClick();
+    expect(s.getState().status).toBe("Arc drawing cancelled.");
+    expect(s.getState().drawMode).toBe(false);
+    s.select({ kind: "place", id: p });
+    s.handleCanvasBackgroundClick();
+    expect(s.getState().selection).toBeNull();
+  });
+});
+
+describe("§5 inspector edits via store", () => {
+  it("invalid label edit emits alert and returns false", () => {
+    const s = fresh();
+    const p1 = s.addPlace(0, 0);
+    const p2 = s.addPlace(0, 0);
+    const ok = s.editLabel(p2, "P1");
+    expect(ok).toBe(false);
+    expect(s.getState().alert).toContain("Label must be non-empty and unique");
+    // unchanged
+    expect(s.getState().net.places.find((p) => p.id === p2)!.label).toBe("P2");
+    expect(p1).toBeTruthy();
+  });
+
+  it("invalid token edit emits alert and returns false", () => {
+    const s = fresh();
+    const p = s.addPlace(0, 0);
+    expect(s.editInitialTokens(p, "-1")).toBe(false);
+    expect(s.getState().alert).toBe("Tokens must be a non-negative integer.");
+    expect(s.editCurrentTokens(p, "abc")).toBe(false);
+  });
+
+  it("valid weight edit updates and returns true", () => {
+    const s = fresh();
+    const p = s.addPlace(0, 0);
+    const t = s.addTransition(0, 0);
+    s.startDrawArc();
+    s.handleNodeActivate(p);
+    s.handleNodeActivate(t);
+    const arcId = s.getState().net.arcs[0].id;
+    expect(s.editWeight(arcId, "3")).toBe(true);
+    expect(s.getState().net.arcs[0].weight).toBe(3);
+  });
+});
+
+describe("§7.5 reset marking", () => {
+  it("sets status Marking reset.", () => {
+    const s = fresh();
+    s.resetMarking();
+    expect(s.getState().status).toBe("Marking reset.");
+  });
+});
