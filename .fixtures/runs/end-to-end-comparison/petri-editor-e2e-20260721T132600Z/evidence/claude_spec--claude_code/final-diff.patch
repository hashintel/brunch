+
+  it("Escape cancels draw mode leaving zero arcs", () => {
+    click("Add place");
+    click("Add transition");
+    click("Draw arc");
+    const drawBtn = getByRole(container, "button", { name: "Draw arc" });
+    expect(drawBtn.getAttribute("aria-pressed")).toBe("true");
+    fireEvent.keyDown(getByRole(container, "region", { name: "Petri net canvas" }), {
+      key: "Escape",
+    });
+    expect(drawBtn.getAttribute("aria-pressed")).toBe("false");
+    expect(queryAllByRole(container, "button", { name: /^Arc: / }).length).toBe(0);
+  });
+
+  it("empty-canvas click cancels draw mode leaving zero arcs", () => {
+    click("Add place");
+    click("Add transition");
+    click("Draw arc");
+    fireEvent.click(getByRole(container, "button", { name: "Place: P1" })); // pick source
+    const bg = container.querySelector("[data-bg]") as Element;
+    fireEvent.click(bg);
+    expect(getByRole(container, "button", { name: "Draw arc" }).getAttribute("aria-pressed")).toBe(
+      "false",
+    );
+    expect(queryAllByRole(container, "button", { name: /^Arc: / }).length).toBe(0);
+  });
+});
+
+describe("§8.3 fire selected transition button", () => {
+  it("is never HTML-disabled and uses aria-disabled when not fireable", () => {
+    const fireBtn = getByRole(container, "button", { name: "Fire selected transition" });
+    expect((fireBtn as HTMLButtonElement).disabled).toBe(false);
+    expect(fireBtn.getAttribute("aria-disabled")).toBe("true");
+  });
+
+  it("firing with nothing selected emits Nothing selected. alert", () => {
+    click("Fire selected transition");
+    expect(getByRole(container, "alert").textContent).toBe("Nothing selected.");
+  });
+
+  it("firing a disabled transition is a no-op with the correct alert", () => {
+    click("Add transition");
+    click("Add place");
+    click("Draw arc");
+    fireEvent.click(getByRole(container, "button", { name: "Place: P1" }));
+    fireEvent.click(getByRole(container, "button", { name: /^Transition: T1/ }));
+    // select the (now disabled) transition
+    fireEvent.click(getByRole(container, "button", { name: "Transition: T1 (disabled)" }));
+    click("Fire selected transition");
+    expect(getByRole(container, "alert").textContent).toBe("Transition T1 is not enabled.");
+  });
+
+  it("firing an enabled transition emits Fired <label>.", () => {
+    click("Add transition");
+    fireEvent.click(getByRole(container, "button", { name: "Transition: T1 (enabled)" }));
+    click("Fire selected transition");
+    expect(getByRole(container, "status").textContent).toBe("Fired T1.");
+  });
+});
+
+describe("§6 delete + §7 toolbar actions", () => {
+  it("delete selection removes the selected node and cascades arcs", () => {
+    click("Add place");
+    click("Add transition");
+    click("Draw arc");
+    fireEvent.click(getByRole(container, "button", { name: "Place: P1" }));
+    fireEvent.click(getByRole(container, "button", { name: /^Transition: T1/ }));
+    fireEvent.click(getByRole(container, "button", { name: "Place: P1" })); // select place
+    click("Delete selection");
+    expect(queryByRole(container, "button", { name: "Place: P1" })).toBeNull();
+    expect(queryAllByRole(container, "button", { name: /^Arc: / }).length).toBe(0);
+    expect(getByRole(container, "status").textContent).toBe("Deleted P1 and 1 connected arc(s).");
+  });
+
+  it("New net clears the canvas", () => {
+    click("Add place");
+    click("New net");
+    expect(queryAllByRole(container, "button", { name: /^Place: / }).length).toBe(0);
+    expect(getByRole(container, "status").textContent).toBe("New net created.");
+  });
+
+  it("no-selection hint is shown initially", () => {
+    expect(
+      getByText(container, "Select a place, transition, or arc to edit its properties."),
+    ).toBeTruthy();
+  });
+});
