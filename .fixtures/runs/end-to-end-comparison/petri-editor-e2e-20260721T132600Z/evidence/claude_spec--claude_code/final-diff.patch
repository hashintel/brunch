+  it("creating an arc yields an element named 'Arc: P1 to T1'", () => {
+    click("Add place");
+    click("Add transition");
+    click("Draw arc");
+    fireEvent.click(getByRole(container, "button", { name: "Place: P1" }));
+    fireEvent.click(getByRole(container, "button", { name: /^Transition: T1/ }));
+    expect(getByRole(container, "button", { name: "Arc: P1 to T1" })).toBeTruthy();
+  });
+});
+
+describe("§9.4 inspector fields", () => {
+  it("selecting a place exposes Label, Initial tokens, Current tokens", () => {
+    click("Add place"); // auto-selected
+    expect(getByRole(container, "textbox", { name: "Label" })).toBeTruthy();
+    expect(getByRole(container, "spinbutton", { name: "Initial tokens" })).toBeTruthy();
+    expect(getByRole(container, "spinbutton", { name: "Current tokens" })).toBeTruthy();
+  });
+
+  it("selecting an arc exposes Arc weight", () => {
+    click("Add place");
+    click("Add transition");
+    click("Draw arc");
+    fireEvent.click(getByRole(container, "button", { name: "Place: P1" }));
+    fireEvent.click(getByRole(container, "button", { name: /^Transition: T1/ }));
+    // arc auto-selected after creation
+    expect(getByRole(container, "spinbutton", { name: "Arc weight" })).toBeTruthy();
