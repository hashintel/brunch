@@ -0,0 +1,384 @@
+import { describe, it, expect } from "vitest";
+import {
+  emptyNet,
+  addPlace,
+  addTransition,
+  addArc,
+  isEnabled,
+  fire,
+  deleteNode,
+  deleteArc,
+  resetMarking,
+  setLabel,
+  setInitialTokens,
+  setCurrentTokens,
+  setWeight,
+  serializeNet,
+  parseNet,
+  validateNet,
+  nodeKind,
+} from "../src/model";
+
+// ---- §4 firing semantics -------------------------------------------------
+
+describe("§4 firing semantics", () => {
+  it("a transition with no input arcs is enabled", () => {
+    let net = emptyNet();
+    const t = addTransition(net, 0, 0);
+    expect(isEnabled(t.net, t.id)).toBe(true);
+  });
+
+  it("firing a no-input transition adds weight tokens to each output place", () => {
+    let net = emptyNet();
+    const t = addTransition(net, 0, 0);
+    net = t.net;
+    const p1 = addPlace(net, 0, 0);
+    net = p1.net;
+    const p2 = addPlace(net, 0, 0);
+    net = p2.net;
+    net = addArc(net, t.id, p1.id);
+    net = addArc(net, t.id, p2.id);
+    net = setWeight(net, net.arcs[1].id, 3);
+    net = fire(net, t.id);
+    expect(net.places.find((p) => p.id === p1.id)!.currentTokens).toBe(1);
+    expect(net.places.find((p) => p.id === p2.id)!.currentTokens).toBe(3);
+  });
+
+  it("enabled iff every input place has at least the arc weight (boundary)", () => {
+    let net = emptyNet();
+    const p = addPlace(net, 0, 0);
+    net = p.net;
+    const t = addTransition(net, 0, 0);
+    net = t.net;
+    net = addArc(net, p.id, t.id);
+    net = setWeight(net, net.arcs[0].id, 2);
+    net = setInitialTokens(net, p.id, 2);
+    net = setCurrentTokens(net, p.id, 2);
+    expect(isEnabled(net, t.id)).toBe(true); // exactly equal -> enabled
+    net = setCurrentTokens(net, p.id, 1);
+    expect(isEnabled(net, t.id)).toBe(false); // one below -> disabled
+  });
+
+  it("firing is atomic and a self-loop nets (w_out - w_in)", () => {
+    let net = emptyNet();
+    const p = addPlace(net, 0, 0);
+    net = p.net;
+    const t = addTransition(net, 0, 0);
+    net = t.net;
+    net = setInitialTokens(net, p.id, 5);
+    net = setCurrentTokens(net, p.id, 5);
+    net = addArc(net, p.id, t.id); // P -> T, w_in
+    net = setWeight(net, net.arcs[0].id, 2);
+    net = addArc(net, t.id, p.id); // T -> P, w_out
+    net = setWeight(net, net.arcs[1].id, 3);
+    expect(isEnabled(net, t.id)).toBe(true);
+    net = fire(net, t.id);
+    expect(net.places[0].currentTokens).toBe(6); // 5 - 2 + 3
+  });
+
+  it("firing a disabled transition is a no-op", () => {
+    let net = emptyNet();
+    const p = addPlace(net, 0, 0);
+    net = p.net;
+    const t = addTransition(net, 0, 0);
+    net = t.net;
+    net = addArc(net, p.id, t.id); // needs 1 token, has 0
+    const before = serializeNet(net);
+    net = fire(net, t.id);
+    expect(serializeNet(net)).toBe(before);
+  });
+});
+
+// ---- §5 validation -------------------------------------------------------
+
+describe("§5 validation", () => {
+  it("V1 rejects place->place, transition->transition, and same-endpoint arcs", () => {
+    let net = emptyNet();
+    const p1 = addPlace(net, 0, 0);
+    net = p1.net;
+    const p2 = addPlace(net, 0, 0);
+    net = p2.net;
+    const t1 = addTransition(net, 0, 0);
+    net = t1.net;
+    expect(() => addArc(net, p1.id, p2.id)).toThrow(
+      "Arcs must connect a place to a transition.",
+    );
+    expect(() => addArc(net, p1.id, p1.id)).toThrow(
+      "Arcs must connect a place to a transition.",
+    );
+    let net2 = net;
+    const t2 = addTransition(net2, 0, 0);
+    net2 = t2.net;
+    expect(() => addArc(net2, t1.id, t2.id)).toThrow(
+      "Arcs must connect a place to a transition.",
+    );
+  });
+
+  it("V2 rejects duplicate (sourceId, targetId) arcs", () => {
+    let net = emptyNet();
+    const p = addPlace(net, 0, 0);
+    net = p.net;
+    const t = addTransition(net, 0, 0);
+    net = t.net;
+    net = addArc(net, p.id, t.id);
+    expect(() => addArc(net, p.id, t.id)).toThrow(/already exists/);
+  });
+
+  it("V3 allows a self-loop via a transition (P->T and T->P)", () => {
+    let net = emptyNet();
+    const p = addPlace(net, 0, 0);
+    net = p.net;
+    const t = addTransition(net, 0, 0);
+    net = t.net;
+    net = addArc(net, p.id, t.id);
+    net = addArc(net, t.id, p.id);
+    expect(net.arcs.length).toBe(2);
+  });
+
+  it("V4 rejects empty, whitespace-only, and non-unique labels within kind", () => {
+    let net = emptyNet();
+    const p1 = addPlace(net, 0, 0);
+    net = p1.net; // P1
+    const p2 = addPlace(net, 0, 0);
+    net = p2.net; // P2
+    expect(() => setLabel(net, p2.id, "")).toThrow(/Label must be non-empty and unique/);
+    expect(() => setLabel(net, p2.id, "   ")).toThrow(/Label must be non-empty and unique/);
+    expect(() => setLabel(net, p2.id, "P1")).toThrow(/Label must be non-empty and unique/);
+  });
+
+  it("V4 allows a P1/T1 coexistence (labels unique only within kind)", () => {
+    let net = emptyNet();
+    const p = addPlace(net, 0, 0);
+    net = p.net; // P1
+    const t = addTransition(net, 0, 0);
+    net = t.net; // T1
+    // rename transition to P1 -> allowed (different kind)
+    net = setLabel(net, t.id, "P1");
+    expect(net.transitions[0].label).toBe("P1");
+    expect(net.places[0].label).toBe("P1");
+  });
+
+  it("V5 rejects negative, non-integer, non-finite, and NaN token values", () => {
+    let net = emptyNet();
+    const p = addPlace(net, 0, 0);
+    net = p.net;
+    for (const bad of [-1, 1.5, Infinity, -Infinity, NaN]) {
+      expect(() => setInitialTokens(net, p.id, bad)).toThrow(
+        "Tokens must be a non-negative integer.",
+      );
+      expect(() => setCurrentTokens(net, p.id, bad)).toThrow(
+        "Tokens must be a non-negative integer.",
+      );
+    }
+    // 0 is accepted
+    expect(() => setInitialTokens(net, p.id, 0)).not.toThrow();
+  });
+
+  it("V6 rejects zero, negative, non-integer, and non-finite arc weights", () => {
+    let net = emptyNet();
+    const p = addPlace(net, 0, 0);
+    net = p.net;
+    const t = addTransition(net, 0, 0);
+    net = t.net;
+    net = addArc(net, p.id, t.id);
+    const arcId = net.arcs[0].id;
+    for (const bad of [0, -1, 1.5, Infinity, NaN]) {
+      expect(() => setWeight(net, arcId, bad)).toThrow(
+        "Arc weight must be a positive integer.",
+      );
+    }
+    expect(() => setWeight(net, arcId, 2)).not.toThrow();
+  });
+
+  it("V7 editing current tokens does not modify initial tokens", () => {
+    let net = emptyNet();
+    const p = addPlace(net, 0, 0);
+    net = p.net;
+    net = setInitialTokens(net, p.id, 4);
+    net = setCurrentTokens(net, p.id, 4);
+    net = setCurrentTokens(net, p.id, 1);
+    const pl = net.places[0];
+    expect(pl.currentTokens).toBe(1);
+    expect(pl.initialTokens).toBe(4);
+  });
+
+  it("V8 reset marking restores currentTokens := initialTokens without touching structure", () => {
+    let net = emptyNet();
+    const p = addPlace(net, 0, 0);
+    net = p.net;
+    net = setInitialTokens(net, p.id, 3);
+    net = setCurrentTokens(net, p.id, 3);
+    net = setCurrentTokens(net, p.id, 0);
+    const before = { places: net.places.length, arcs: net.arcs.length };
+    net = resetMarking(net);
+    expect(net.places[0].currentTokens).toBe(3);
+    expect(net.places[0].initialTokens).toBe(3);
+    expect(net.places.length).toBe(before.places);
+  });
+});
+
+// ---- §6 delete cascade ---------------------------------------------------
+
+describe("§6 delete cascade", () => {
+  it("D1 deleting a node removes all incident arcs and only those", () => {
+    let net = emptyNet();
+    const p1 = addPlace(net, 0, 0);
+    net = p1.net;
+    const p2 = addPlace(net, 0, 0);
+    net = p2.net;
+    const t = addTransition(net, 0, 0);
+    net = t.net;
+    net = addArc(net, p1.id, t.id);
+    net = addArc(net, t.id, p2.id);
+    const res = deleteNode(net, t.id);
+    expect(res.net.transitions.length).toBe(0);
+    expect(res.net.arcs.length).toBe(0);
+    expect(res.removedArcs).toBe(2);
+    expect(res.net.places.length).toBe(2);
+  });
+
+  it("D2 deleting an arc leaves endpoints untouched", () => {
+    let net = emptyNet();
+    const p = addPlace(net, 0, 0);
+    net = p.net;
+    const t = addTransition(net, 0, 0);
+    net = t.net;
+    net = addArc(net, p.id, t.id);
+    const arcId = net.arcs[0].id;
+    const res = deleteArc(net, arcId);
+    expect(res.net.arcs.length).toBe(0);
+    expect(res.net.places.length).toBe(1);
+    expect(res.net.transitions.length).toBe(1);
+  });
+});
+
+// ---- §7.2/§11 serialize + round trip ------------------------------------
+
+describe("§7 serialize + parse round trip", () => {
+  it("Export -> Import reproduces the exact same Net (deep-equal)", () => {
+    let net = emptyNet();
+    const p = addPlace(net, 120, 80);
+    net = p.net;
+    const t = addTransition(net, 260, 80);
+    net = t.net;
+    net = addArc(net, p.id, t.id);
+    net = setInitialTokens(net, p.id, 2);
+    net = setCurrentTokens(net, p.id, 2);
+    const text = serializeNet(net);
+    const back = parseNet(text);
+    expect(back).toEqual(net);
+  });
+
+  it("serializes collections in creation order", () => {
+    let net = emptyNet();
+    const a = addPlace(net, 0, 0);
+    net = a.net; // P1
+    const b = addPlace(net, 0, 0);
+    net = b.net; // P2
+    const parsed = JSON.parse(serializeNet(net));
+    expect(parsed.places.map((p: any) => p.label)).toEqual(["P1", "P2"]);
+    expect(parsed.schemaVersion).toBe(1);
+  });
+});
+
+// ---- §7.3 import failure surface ----------------------------------------
+
+describe("§7.3 import failure surface", () => {
+  it("non-JSON file -> file is not valid JSON.", () => {
+    expect(() => parseNet("not json {{{")).toThrow("file is not valid JSON.");
+  });
+
+  it("missing schemaVersion -> schema failure", () => {
+    const bad = JSON.stringify({ places: [], transitions: [], arcs: [] });
+    expect(() => parseNet(bad)).toThrow("schemaVersion must be 1.");
+  });
+
+  it("schemaVersion !== 1 -> schema failure", () => {
+    const bad = JSON.stringify({ schemaVersion: 2, places: [], transitions: [], arcs: [] });
+    expect(() => parseNet(bad)).toThrow("schemaVersion must be 1.");
+  });
+
+  it("arc referencing unknown node id -> specific unknown-node reason", () => {
+    const bad = JSON.stringify({
+      schemaVersion: 1,
+      places: [{ id: "p1", label: "P1", x: 0, y: 0, initialTokens: 0, currentTokens: 0 }],
+      transitions: [],
+      arcs: [{ id: "a3", sourceId: "p1", targetId: "p9", weight: 1 }],
+    });
+    expect(() => parseNet(bad)).toThrow('arc "a3" references unknown node "p9".');
+  });
+
+  it("duplicate ids -> schema failure", () => {
+    const bad = JSON.stringify({
+      schemaVersion: 1,
+      places: [
+        { id: "dup", label: "P1", x: 0, y: 0, initialTokens: 0, currentTokens: 0 },
+        { id: "dup", label: "P2", x: 0, y: 0, initialTokens: 0, currentTokens: 0 },
+      ],
+      transitions: [],
+      arcs: [],
+    });
+    expect(() => parseNet(bad)).toThrow(/duplicate id/);
+  });
+
+  it("endpoint-kind violation -> specific reason", () => {
+    const bad = JSON.stringify({
+      schemaVersion: 1,
+      places: [
+        { id: "p1", label: "P1", x: 0, y: 0, initialTokens: 0, currentTokens: 0 },
+        { id: "p2", label: "P2", x: 0, y: 0, initialTokens: 0, currentTokens: 0 },
+      ],
+      transitions: [],
+      arcs: [{ id: "a5", sourceId: "p1", targetId: "p2", weight: 1 }],
+    });
+    expect(() => parseNet(bad)).toThrow(
+      'arc "a5" connects two places; arcs must connect a place to a transition.',
+    );
+  });
+
+  it("non-positive weight -> schema failure", () => {
+    const bad = JSON.stringify({
+      schemaVersion: 1,
+      places: [{ id: "p1", label: "P1", x: 0, y: 0, initialTokens: 0, currentTokens: 0 }],
+      transitions: [{ id: "t1", label: "T1", x: 0, y: 0 }],
+      arcs: [{ id: "a1", sourceId: "p1", targetId: "t1", weight: 0 }],
+    });
+    expect(() => parseNet(bad)).toThrow("arc weight must be a positive integer.");
+  });
+
+  it("non-unique labels -> specific reason", () => {
+    const bad = JSON.stringify({
+      schemaVersion: 1,
+      places: [
+        { id: "p1", label: "P1", x: 0, y: 0, initialTokens: 0, currentTokens: 0 },
+        { id: "p2", label: "P1", x: 0, y: 0, initialTokens: 0, currentTokens: 0 },
+      ],
+      transitions: [],
+      arcs: [],
+    });
+    expect(() => parseNet(bad)).toThrow('place label "P1" is not unique.');
+  });
+
+  it("validateNet accepts a well-formed net", () => {
+    const good = {
+      schemaVersion: 1,
+      places: [{ id: "p1", label: "P1", x: 0, y: 0, initialTokens: 1, currentTokens: 1 }],
+      transitions: [{ id: "t1", label: "T1", x: 0, y: 0 }],
+      arcs: [{ id: "a1", sourceId: "p1", targetId: "t1", weight: 1 }],
+    };
+    expect(validateNet(good)).toEqual(good);
+  });
+});
+
+describe("nodeKind", () => {
+  it("classifies places and transitions", () => {
+    let net = emptyNet();
+    const p = addPlace(net, 0, 0);
+    net = p.net;
+    const t = addTransition(net, 0, 0);
+    net = t.net;
+    expect(nodeKind(net, p.id)).toBe("place");
+    expect(nodeKind(net, t.id)).toBe("transition");
+    expect(nodeKind(net, "nope")).toBe(null);
+  });
+});
