   {
     "spec": {
       "slug": "rust-todo-cli",
       "name": "Rust Todo CLI"
     },
     "nodes": [
       {
         "local_id": 1,
         "plane": "intent",
         "kind": "goal",
         "title": "Personal productivity CLI tool for developers",
          "body": "A developer-facing command-line todo app that is as simple as possible. Targets individual developers who want lightweight task tracking without leaving the terminal.",
         "basis": "explicit",
         "source": "rust-todo-cli [goal]",
         "detail": null
       },
       {
         "local_id": 2,
         "plane": "intent",
         "kind": "constraint",
         "title": "Local flat-file storage only (no server, no DB)",
          "body": "Tasks are stored in a local file (JSON, TOML, or plain text). Zero external dependencies for storage; file must be human-readable and manually editable.",
         "basis": "explicit",
         "source": "rust-todo-cli [constraint]",
         "detail": null
       },
       {
         "local_id": 3,
         "plane": "intent",
         "kind": "constraint",
         "title": "Minimal initial scope — no due dates, no tags, no edit",
          "body": "V1 is restricted to: add, complete, delete, list/filter, and priority levels. Due dates, tags, and text editing are explicitly out of initial scope.",
         "basis": "explicit",
         "source": "rust-todo-cli [constraint]",
         "detail": null
       },
       {
         "local_id": 4,
         "plane": "intent",
         "kind": "requirement",
         "title": "Add a task from the CLI",
         "body": null,
         "basis": "explicit",
         "source": "rust-todo-cli [requirement]",
         "detail": { "form": "plain" }
       },
       {
         "local_id": 5,
         "plane": "intent",
         "kind": "requirement",
         "title": "Mark a task complete",
         "body": null,
         "basis": "explicit",
         "source": "rust-todo-cli [requirement]",
         "detail": { "form": "plain" }
       },
       {
         "local_id": 6,
         "plane": "intent",
         "kind": "requirement",
         "title": "Delete a task",
         "body": null,
         "basis": "explicit",
         "source": "rust-todo-cli [requirement]",
         "detail": { "form": "plain" }
       },
       {
         "local_id": 7,
         "plane": "intent",
         "kind": "requirement",
         "title": "List and filter tasks",
         "body": null,
         "basis": "explicit",
         "source": "rust-todo-cli [requirement]",
         "detail": { "form": "plain" }
       },
       {
         "local_id": 8,
         "plane": "intent",
         "kind": "requirement",
         "title": "Assign priority level to a task",
         "body": null,
         "basis": "explicit",
         "source": "rust-todo-cli [requirement]",
         "detail": { "form": "plain" }
       },
       {
         "local_id": 9,
         "plane": "intent",
         "kind": "decision",
         "title": "Priority model: three levels (high / medium / low)",
         "body": null,
         "basis": "explicit",
         "source": "rust-todo-cli [decision]",
         "detail": {
           "chosen_option": "Three named levels: high, medium, low",
           "rejected": ["Numeric score (1–5 or 1–10)", "Binary starred/normal flag"],
            "rationale": "Three named levels are simple to type in a CLI, unambiguous when filtering, and match developer mental models without over-engineering."
         }
       },
       {
         "local_id": 10,
         "plane": "intent",
         "kind": "requirement",
         "title": "Filter tasks by status (pending / done)",
         "body": null,
         "basis": "explicit",
         "source": "rust-todo-cli [requirement]",
         "detail": { "form": "plain" }
       },
       {
         "local_id": 11,
         "plane": "intent",
         "kind": "requirement",
         "title": "Filter tasks by priority level",
         "body": null,
         "basis": "explicit",
         "source": "rust-todo-cli [requirement]",
         "detail": { "form": "plain" }
       },
       {
         "local_id": 12,
         "plane": "intent",
         "kind": "requirement",
         "title": "Filter tasks by keyword / text search",
         "body": null,
         "basis": "explicit",
         "source": "rust-todo-cli [requirement]",
         "detail": { "form": "plain" }
       },
       {
         "local_id": 13,
         "plane": "intent",
         "kind": "decision",
         "title": "Task file format: JSON",
         "body": null,
         "basis": "explicit",
         "source": "rust-todo-cli [decision]",
         "detail": {
           "chosen_option": "JSON",
           "rejected": ["TOML", "Plain text (one task per line)", "YAML"],
            "rationale": "JSON is universally parseable, has no ambiguity around whitespace, and is well-supported across languages. The reduced hand-editability is an acceptable tradeoff given the CLI handles all mutations."
         }
       },
       {
         "local_id": 14,
         "plane": "intent",
         "kind": "decision",
         "title": "CLI interface: subcommand style",
         "body": null,
         "basis": "explicit",
         "source": "rust-todo-cli [decision]",
         "detail": {
           "chosen_option": "Subcommand style (e.g. todo add, todo done, todo list)",
           "rejected": ["Flag-driven", "Interactive TUI", "Subcommand + optional TUI"],
            "rationale": "Subcommand style is idiomatic for CLI task tools, composable in shell scripts, and easy to pipe. Simplest match for a dev-audience minimal tool."
         }
       },
       {
         "local_id": 15,
         "plane": "intent",
         "kind": "decision",
         "title": "Task ID scheme: sequential integers (renumber on delete)",
         "body": null,
         "basis": "explicit",
         "source": "rust-todo-cli [decision]",
         "detail": {
           "chosen_option": "Sequential integers starting from 1, renumbered after deletion",
           "rejected": ["Stable integers with gaps", "Short alphanumeric IDs"],
            "rationale": "Sequential integers are the easiest to type and remember. Renumbering on delete is acceptable given the minimal scope and single-user context."
         }
       },
       {
         "local_id": 16,
         "plane": "intent",
         "kind": "decision",
         "title": "Task file location: ~/.todo.json",
         "body": null,
         "basis": "explicit",
         "source": "rust-todo-cli [decision]",
         "detail": {
           "chosen_option": "~/.todo.json — single global dotfile in the home directory",
           "rejected": ["~/.config/todo/tasks.json", "./todo.json (current directory)", "XDG_DATA_HOME-aware path"],
            "rationale": "Simplest possible location for a minimal tool. Single global list, no directory creation needed, immediately obvious to the user."
         }
       },
       {
         "local_id": 17,
         "plane": "intent",
         "kind": "decision",
         "title": "Implementation language: Rust",
         "body": "The execution harness follows the committed Rust stack.\nexecute.setup: cargo fetch\nexecute.build: cargo build --release\nexecute.verify: cargo test",
         "basis": "explicit",
         "source": "rust-todo-cli [decision]",
         "detail": {
           "chosen_option": "Rust",
           "rejected": ["TypeScript / Node.js", "Go", "Python"],
            "rationale": "Static binary with zero runtime dependency, fastest startup, memory safety guarantees. Aligns with developer audience expectations for a high-quality distributable CLI tool. serde_json for JSON, clap for subcommands."
         }
       },
       {
         "local_id": 18,
         "plane": "intent",
         "kind": "decision",
         "title": "Project structure: flat single-file (main.rs only)",
         "body": null,
         "basis": "explicit",
         "source": "rust-todo-cli [decision]",
         "detail": {
           "chosen_option": "Single main.rs — no modules, no workspace",
           "rejected": ["Modular (main.rs + lib modules)", "Cargo workspace"],
            "rationale": "Spec is minimal by design. A single file is the simplest match for the scope (~200-300 lines). Refactoring to modules later is mechanical if scope ever grows."
         }
       },
       {
         "local_id": 19,
         "plane": "intent",
         "kind": "decision",
         "title": "CLI parsing crate: clap (derive API)",
         "body": null,
         "basis": "explicit",
         "source": "rust-todo-cli [decision]",
         "detail": {
           "chosen_option": "clap with derive macros",
           "rejected": ["argh", "std::env::args only"],
            "rationale": "Industry standard for Rust CLIs. Derive API maps cleanly onto the subcommand model already decided. Built-in help generation and error messages without manual work."
         }
       },
       {
         "local_id": 20,
         "plane": "intent",
         "kind": "decision",
         "title": "JSON serialization: serde + serde_json",
         "body": null,
         "basis": "explicit",
         "source": "rust-todo-cli [decision]",
         "detail": {
           "chosen_option": "serde + serde_json",
           "rejected": ["manual JSON construction", "json crate"],
            "rationale": "Standard Rust JSON stack. Derive macros on the Task struct give zero-cost serialization. No viable alternative in the Rust ecosystem for JSON r/w."
         }
       },
       {
         "local_id": 21,
         "plane": "intent",
         "kind": "decision",
         "title": "Terminal output: colored crate",
         "body": null,
         "basis": "explicit",
         "source": "rust-todo-cli [decision]",
         "detail": {
           "chosen_option": "colored crate for terminal color output",
           "rejected": ["owo-colors", "termcolor", "anstyle/anstream"],
           "rationale": "Simple ergonomics (.red(), .bold()) with minimal API surface. Best match for a flat single-file tool where terseness matters."
         }
       },
       {
         "local_id": 22,
         "plane": "plan",
         "kind": "milestone",
         "title": "M1: Project scaffold",
         "body": "cargo new todo-cli, Cargo.toml with clap/serde/serde_json/colored, empty main.rs compiles clean.",
         "basis": "explicit",
         "source": "rust-todo-cli [milestone]",
         "detail": null
       },
       {
         "local_id": 23,
         "plane": "plan",
         "kind": "milestone",
         "title": "M2: Task model + storage",
         "body": "Task struct (id, text, done, priority), JSON r/w to ~/.todo.json, load/save functions.",
         "basis": "explicit",
         "source": "rust-todo-cli [milestone]",
         "detail": null
       },
       {
         "local_id": 24,
         "plane": "plan",
         "kind": "milestone",
         "title": "M3: Core commands",
         "body": "Implement add, done, delete subcommands with clap derive. Sequential ID assignment and renumbering on delete.",
         "basis": "explicit",
         "source": "rust-todo-cli [milestone]",
         "detail": null
       },
       {
         "local_id": 25,
         "plane": "plan",
         "kind": "milestone",
         "title": "M4: List + filter",
         "body": "list subcommand with --status, --priority, --search flags. Colored output: priority colors, strikethrough or dim for done tasks.",
         "basis": "explicit",
         "source": "rust-todo-cli [milestone]",
         "detail": null
       },
       {
