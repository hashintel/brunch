{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "options": {
    "typeAware": true,
    "typeCheck": true
  },
  "rules": {
    "typescript/no-deprecated": "error",
    "unicorn/no-empty-file": "off"
  },
  "ignorePatterns": [
    ".agents/**",
    ".github/**",
    ".claude/**",
    "*.md",
    "docs/**",
    "memory/**",
    ".fixtures/**",
    "@types/**",
    "tmp/**",
    "dist-web/**",
    "bin/**",
    "dist/**",
    "drizzle/**"
  ]
}
