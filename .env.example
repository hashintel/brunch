ANTHROPIC_API_KEY=

# FE-764: full Petrinaut route URL (path included, e.g. https://…/brunch) used by
# `brunch cook --petrinaut-stream` to compose the live-stream launcher URL. CLI flag
# `--petrinaut-url=<url>` overrides this, and an inline shell value wins over this
# file. No baked-in default — a wrong default silently opens the wrong tab.
PETRINAUT_URL=
