                "properties": {
                  "exchangeId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "lens": {
                    "type": "string",
                    "const": "intent"
                  },
                  "mode": {
                    "type": "string",
                    "enum": [
                      "text",
                      "single-select",
                      "multi-select",
                      "review"
                    ]
                  },
                  "prompt": {
                    "type": "string",
                    "minLength": 1
                  },
                  "details": {
                    "type": "string",
                    "minLength": 1
                  },
                  "options": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "label": {
                          "type": "string",
                          "minLength": 1
                        },
                        "content": {
                          "type": "string",
                          "minLength": 1
                        },
                        "rationale": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "id",
                        "label",
                        "content"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "note": {
                    "type": "object",
                    "properties": {
                      "allowed": {
