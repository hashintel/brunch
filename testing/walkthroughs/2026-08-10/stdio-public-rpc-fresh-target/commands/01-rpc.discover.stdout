    {
      "method": "execute.replanAbandonRun",
      "description": "Mark a non-terminal executor run abandoned without deleting worktree, reports, Petri, promotion, or graph state.",
      "paramsSchema": {
        "type": "object",
        "required": [
          "runId"
        ],
        "properties": {
          "runId": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
