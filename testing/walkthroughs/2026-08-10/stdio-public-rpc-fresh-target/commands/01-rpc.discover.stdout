                      "title",
                      "places",
                      "transitions"
                    ],
                    "properties": {
                      "version": {
                        "type": "number"
                      },
                      "meta": {
                        "type": "object",
                        "required": [
                          "generator"
                        ],
                        "properties": {
                          "generator": {
                            "type": "string"
                          },
                          "generatorVersion": {
                            "type": "string"
                          }
