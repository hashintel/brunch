    {
      "method": "execute.runTraceIndex",
      "description": "Return graph-node-to-run traceability for one spec, derived from run plans and reports without exposing run artifact paths.",
      "paramsSchema": {
        "type": "object",
        "required": [
          "specId"
        ],
        "properties": {
          "specId": {
            "type": "integer",
            "minimum": 1
          }
        },
        "additionalProperties": false
      },
      "resultSchema": {
        "type": "object",
        "required": [
          "traces"
        ],
        "properties": {
          "traces": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "nodeCode",
                "runId",
                "specId",
                "runStatus",
                "sliceIds",
                "failedSliceIds",
                "completedSliceIds"
              ],
              "properties": {
                "nodeCode": {
                  "type": "string"
                },
                "runId": {
                  "type": "string"
                },
                "specId": {
                  "type": "string"
                },
                "runStatus": {
                  "type": "string"
                },
                "sliceIds": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "failedSliceIds": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "completedSliceIds": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      },
      "examples": [
        {
          "jsonrpc": "2.0",
          "id": 22,
          "method": "execute.runTraceIndex",
          "params": {
            "specId": 1
          }
        }
      ]
    },
    {
      "method": "execute.replanRecommendation",
      "description": "Return a human-readable retry/replan diagnosis and allowed action set for one executor run, without mutating run state.",
      "paramsSchema": {
        "type": "object",
        "required": [
          "runId",
          "specId"
        ],
        "properties": {
          "runId": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "specId": {
            "type": "integer",
            "minimum": 1
          },
          "mode": {
            "anyOf": [
              {
                "type": "string",
                "const": "greenfield"
              },
              {
                "type": "string",
                "const": "brownfield"
              }
            ]
          }
        },
        "additionalProperties": false
      },
      "resultSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": true
      },
      "examples": [
        {
          "jsonrpc": "2.0",
          "id": 23,
          "method": "execute.replanRecommendation",
          "params": {
            "runId": "run-1",
            "specId": 1
          }
        }
      ]
    },
