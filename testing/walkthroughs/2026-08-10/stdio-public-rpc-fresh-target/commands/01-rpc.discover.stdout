                    ],
                    "additionalProperties": false
                  },
                  "reviewSet": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {}
                  },
                  "digestAbstract": {
                    "type": "string",
                    "minLength": 1
                  },
                  "respondsToPresentTool": {
                    "type": "string",
                    "enum": [
                      "present_candidates",
                      "present_review_set",
                      "present_digest"
                    ]
                  }
                },
                "required": [
                  "exchangeId",
                  "lens",
                  "mode",
                  "prompt",
                  "options",
                  "note"
                ],
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "status",
              "exchange"
            ],
            "properties": {
              "status": {
                "type": "string",
                "const": "idle"
              },
              "exchange": {
                "type": "null"
              }
            },
            "additionalProperties": false
          }
        ]
      },
      "examples": [
        {
          "jsonrpc": "2.0",
          "id": 9,
          "method": "session.pendingExchange"
        },
        {
          "jsonrpc": "2.0",
          "id": 10,
          "method": "session.pendingExchange",
          "params": {
            "sessionId": "session-1",
            "specId": 1
          }
        }
      ]
    },
    {
      "method": "session.submitExchangeResponse",
      "description": "Submit a text, single-choice, or multi-choice answer for the selected session's current deterministic tuple-shaped pending structured exchange.",
      "paramsSchema": {
        "type": "object",
        "required": [
          "exchangeId",
          "answer"
        ],
        "properties": {
          "exchangeId": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "answer": {
            "anyOf": [
              {
                "type": "object",
                "required": [
                  "text"
                ],
                "properties": {
                  "text": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": [
                  "optionId"
                ],
                "properties": {
                  "optionId": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": [
                  "optionIds"
                ],
                "properties": {
                  "optionIds": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    },
                    "minItems": 1
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": [
                  "review"
                ],
                "properties": {
                  "review": {
                    "type": "object",
                    "required": [
                      "decision"
                    ],
                    "properties": {
                      "decision": {
                        "anyOf": [
                          {
                            "type": "string",
                            "const": "approve"
                          },
                          {
                            "type": "string",
                            "const": "request_changes"
                          },
                          {
                            "type": "string",
                            "const": "reject"
                          }
                        ]
                      },
                      "comment": {
                        "type": "string"
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "additionalProperties": false
              }
            ]
          },
          "note": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "resultSchema": {
        "type": "object",
        "required": [
          "status",
          "exchangeId",
          "answer"
        ],
        "properties": {
          "status": {
            "type": "string",
            "const": "accepted"
          },
          "exchangeId": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "answer": {
            "type": "object",
            "properties": {},
            "additionalProperties": true
          },
          "review": {
            "anyOf": [
              {
                "type": "object",
                "required": [
                  "status",
                  "lsn",
                  "createdNodes"
                ],
                "properties": {
                  "status": {
                    "type": "string",
                    "const": "approved"
                  },
                  "lsn": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "createdNodes": {
                    "type": "object",
                    "properties": {},
                    "additionalProperties": true
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": [
                  "status"
                ],
                "properties": {
                  "status": {
                    "anyOf": [
                      {
                        "type": "string",
                        "const": "request_changes"
                      },
                      {
                        "type": "string",
                        "const": "rejected"
                      }
                    ]
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": [
                  "status",
                  "diagnostics"
                ],
                "properties": {
                  "status": {
                    "type": "string",
                    "const": "structural_illegal"
                  },
                  "diagnostics": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {},
                      "additionalProperties": true
                    }
                  }
                },
                "additionalProperties": false
              }
            ]
          },
          "note": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "examples": [
        {
          "jsonrpc": "2.0",
          "id": 11,
          "method": "session.submitExchangeResponse",
          "params": {
            "exchangeId": "deterministic-grounding-choice",
            "answer": {
              "optionId": "new-from-scratch"
            },
            "note": "This is a greenfield product."
          }
        }
      ]
    },
    {
      "method": "session.submitMessage",
      "description": "Append an ordinary user message to the selected session, or record an explicit interruption while a structured exchange is pending.",
      "paramsSchema": {
        "type": "object",
        "required": [
          "text"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "interruption": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "resultSchema": {
        "type": "object",
        "required": [
          "status",
          "messageId",
          "text",
          "interruption"
        ],
        "properties": {
          "status": {
            "type": "string",
            "const": "accepted"
          },
          "messageId": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "interruption": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "examples": [
        {
          "jsonrpc": "2.0",
          "id": 12,
          "method": "session.submitMessage",
          "params": {
            "text": "Please add this to the transcript for the next capture sweep."
          }
        }
      ]
    },
    {
      "method": "execute.runs",
      "description": "List executor run bundles under .brunch/cook/runs with recorded status and artifact-presence flags; torn run metadata is marked unreadable, never an error.",
      "paramsSchema": {
        "type": "void",
        "description": "Omit JSON-RPC params."
      },
      "resultSchema": {
        "type": "object",
        "required": [
          "runs"
        ],
        "properties": {
          "runs": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "object",
                  "required": [
                    "runId",
                    "specId",
                    "status",
                    "presence"
                  ],
                  "properties": {
                    "runId": {
                      "type": "string"
                    },
                    "specId": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string"
                    },
                    "activeSliceId": {
                      "type": "string"
                    },
                    "activeSliceCycle": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "activeSlicePhase": {
                      "anyOf": [
                        {
                          "type": "string",
                          "const": "agent"
                        },
                        {
                          "type": "string",
                          "const": "verify"
                        },
                        {
                          "type": "string",
                          "const": "repair_pending"
                        }
                      ]
                    },
                    "completedSliceIds": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "failedSliceIds": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "supersedesRunId": {
                      "type": "string"
                    },
                    "abandonedAt": {
                      "type": "string"
                    },
                    "abandonReason": {
                      "type": "string"
                    },
                    "presence": {
                      "type": "object",
                      "required": [
                        "worktree",
                        "reports",
                        "petri",
                        "promotion"
                      ],
                      "properties": {
                        "worktree": {
                          "type": "boolean"
                        },
                        "reports": {
                          "type": "boolean"
                        },
                        "petri": {
                          "type": "boolean"
                        },
                        "promotion": {
                          "type": "boolean"
                        }
                      },
                      "additionalProperties": false
                    }
                  },
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "required": [
                    "runId",
                    "unreadable"
                  ],
                  "properties": {
                    "runId": {
                      "type": "string"
                    },
                    "unreadable": {
                      "type": "boolean",
                      "const": true
                    }
                  },
                  "additionalProperties": false
                }
              ]
            }
          }
        },
        "additionalProperties": false
      },
      "examples": [
        {
          "jsonrpc": "2.0",
          "id": 20,
          "method": "execute.runs"
        }
      ]
    },
    {
      "method": "execute.run",
      "description": "Return one executor run projection: recorded run.json snapshot, artifact-presence flags, reports.jsonl and Petri runtime-event tails, plus optional derived Petri projection and raw net artifacts (events lead the metadata snapshot by design).",
      "paramsSchema": {
        "type": "object",
        "required": [
          "runId"
        ],
        "properties": {
          "runId": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "additionalProperties": false
      },
      "resultSchema": {
        "anyOf": [
          {
            "type": "object",
            "required": [
              "runId",
