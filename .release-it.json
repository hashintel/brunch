{
  "preRelease": "alpha",
  "git": {
    "tagName": "${version}",
    "requireBranch": "next",
    "requireCleanWorkingDir": true
  },
  "github": {
    "release": false
  },
  "npm": {
    "publish": true,
    "skipChecks": true
  },
  "hooks": {
    "before:npm:release": ["npm run check:release-pack"]
  }
}
