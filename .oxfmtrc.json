{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 110,
  "singleQuote": true,
  "sortImports": true,
  "sortPackageJson": true,
  "sortTailwindcss": true,
  "ignorePatterns": [
    ".agents/**",
    ".github/**",
    ".claude/**",
    ".pi/**",
    "*.md",
    "package-lock.json",
    "docs/**",
    "memory/**",
    ".fixtures/**",
    "tmp/**",
    "dist-web/**",
    "bin/**",
    "dist/**",
    "drizzle/**",
    "src/treedocs.yaml"
  ]
}
